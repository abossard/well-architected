  <data key="d0">Egress Traffic</data>
  <data key="d1">concept</data>
  <data key="d2">Egress traffic leaves the network and may need inspection to prevent data exfiltration.</data>
  <data key="d3">chunk-84edc61960c2c1e2ea0cf79280a5461f</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/networking.md</data>
  <data key="d5">1777004597</data>
