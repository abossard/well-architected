  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/networking.md</data>
  <data key="d5">1777004594</data>
  <data key="d6"></data>
</node>
<node id="SOC 2 Compliance">
  <data key="d0">SOC 2 Compliance</data>
  <data key="d1">concept</data>
  <data key="d2">SOC 2 compliance requires implementing various network controls including firewalls, WAF, and network security groups.&lt;SEP&gt;SOC 2 compliance is a specific compliance requirement that customers may have, influencing network architecture decisions.</data>
  <data key="d3">chunk-13a9dd5e331588bd7de29586bf88d3b4&lt;SEP&gt;chunk-84edc61960c2c1e2ea0cf79280a5461f</data>
