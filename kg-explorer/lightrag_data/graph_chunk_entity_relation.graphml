  <data key="d5">1777005270</data>
  <data key="d6"></data>
</node>
<node id="Key Management">
  <data key="d0">Key Management</data>
  <data key="d1">concept</data>
  <data key="d2">Key management is an operations area covering encryption keys, credentials, and access control for applications in Azure VMware Solution.</data>
  <data key="d3">chunk-32aeab96a805c5243f99de82ce31a9a4</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/landing-zone-integration.md</data>
