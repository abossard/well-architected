  <data key="d0">Microsoft Defender For Container Registries</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Defender for container registries provides vulnerability scanning for container images.</data>
  <data key="d3">chunk-77437de30be507969c1117574fed4849</data>
