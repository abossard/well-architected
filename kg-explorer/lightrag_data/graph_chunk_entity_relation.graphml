  <data key="d5">1776981747</data>
  <data key="d6"></data>
</node>
<node id="Single-Region Deployment">
  <data key="d0">Single-Region Deployment</data>
  <data key="d1">method</data>
  <data key="d2">Single-region deployment is an approach that simplifies operational requirements and reduces costs but may not meet high reliability requirements.</data>
  <data key="d3">chunk-f0ea658bc5677a379a1105409b6be36f</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/design-guides/regions-availability-zones.md</data>
  <data key="d5">1776981747</data>
  <data key="d6"></data>
</node>
<node id="Zonal Pinned Deployment">
  <data key="d0">Zonal Pinned Deployment</data>
  <data key="d1">method</data>
  <data key="d2">A deployment approach where resources are pinned to a specific availability zone, offering high performance but high operational requirements.</data>
  <data key="d3">chunk-ac69076e8ebd4d001c0267c2edca19ed</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/design-guides/regions-availability-zones.md</data>
  <data key="d5">1776981748</data>
  <data key="d6"></data>
</node>
<node id="Principle Of Simplicity">
  <data key="d0">Principle Of Simplicity</data>
  <data key="d1">concept</data>
  <data key="d2">A reliability principle advising to keep solutions simple to improve security and performance.</data>
  <data key="d3">chunk-ac69076e8ebd4d001c0267c2edca19ed</data>
