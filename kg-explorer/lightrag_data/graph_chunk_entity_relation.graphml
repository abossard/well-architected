<node id="Geo-Redundancy">
  <data key="d0">Geo-Redundancy</data>
  <data key="d1">concept</data>
  <data key="d2">Geo-redundancy is a reliability strategy applied to hot partitions for geographic redundancy.</data>
  <data key="d3">chunk-0a2829ddae563971c0c88cbe1829d1e1</data>
