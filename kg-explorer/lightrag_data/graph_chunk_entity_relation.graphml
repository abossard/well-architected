  <data key="d0">OAuth2</data>
  <data key="d1">concept</data>
  <data key="d2">OAuth2 is an open protocol supported by Azure for standard authentication and authorization.</data>
  <data key="d3">chunk-385f36a776384c86dd2e520eb0f51b04</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996406</data>
  <data key="d6"></data>
</node>
<node id="OpenID Connect">
  <data key="d0">OpenID Connect</data>
  <data key="d1">concept</data>
  <data key="d2">OpenID Connect is an open protocol supported by Azure for standard authentication and authorization.&lt;SEP&gt;OpenID Connect is used alongside OAuth 2 for user authentication via the Microsoft identity platform.&lt;SEP&gt;OpenID Connect (OIDC) is a protocol used for identity federation integration.</data>
  <data key="d3">chunk-385f36a776384c86dd2e520eb0f51b04&lt;SEP&gt;chunk-0af9b59bcc2e38e219c04c0496ed334e&lt;SEP&gt;chunk-3d0166aac21580feb08a54d6067d8103</data>
