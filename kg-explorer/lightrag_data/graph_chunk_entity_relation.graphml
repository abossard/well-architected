  <data key="d6"></data>
</node>
<node id="Enterprise Agreements">
  <data key="d0">Enterprise Agreements</data>
  <data key="d1">concept</data>
  <data key="d2">Agreements offered by cloud service providers that may include discounts or allow use of existing licenses to save money.&lt;SEP&gt;Enterprise Agreements are a type of Azure subscription offering specific pricing and terms for organizations.</data>
  <data key="d3">chunk-76e6af9e7f0b10472ec2406ba2334d3b&lt;SEP&gt;chunk-c288d93fcfdd99e1ec3771981b68f75f</data>
