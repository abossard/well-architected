<node id="Session Management">
  <data key="d0">Session Management</data>
  <data key="d1">method</data>
  <data key="d2">Session management protects session identifiers and tokens from theft or fixation attacks using timeouts and reauthentication.</data>
  <data key="d3">chunk-654e7aada501f6fea6718cd59dbed297</data>
  <data key="d4">well-architected/security/harden-resources.md</data>
  <data key="d5">1776996336</data>
  <data key="d6"></data>
</node>
<node id="HTTP Security Headers">
  <data key="d0">HTTP Security Headers</data>
  <data key="d1">method</data>
  <data key="d2">HTTP security headers such as CSP, X-Content-Type-Options, and X-Frame-Options mitigate common web vulnerabilities in HTTP responses.</data>
  <data key="d3">chunk-654e7aada501f6fea6718cd59dbed297</data>
  <data key="d4">well-architected/security/harden-resources.md</data>
  <data key="d5">1776996337</data>
