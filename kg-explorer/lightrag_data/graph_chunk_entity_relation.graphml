  <data key="d5">1776995990</data>
  <data key="d6"></data>
</node>
<node id="MassTransit">
  <data key="d0">MassTransit</data>
  <data key="d1">artifact</data>
  <data key="d2">A messaging framework with built-in resiliency features.&lt;SEP&gt;MassTransit is a library that provides saga-based checkpoint functionality with transparent state persistence.</data>
  <data key="d3">chunk-36d66c785cc9b10b4cf377888b6bd59f&lt;SEP&gt;chunk-3df6e00fa9a90ca53e8d360c865875b4</data>
