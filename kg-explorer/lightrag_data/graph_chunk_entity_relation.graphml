<node id="Azure Developer CLI">
  <data key="d0">Azure Developer CLI</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Developer CLI is an open-source tool that accelerates deploying applications from local development to Azure.</data>
  <data key="d3">chunk-4285f3b1d912059b039db58435cd461a</data>
  <data key="d4">well-architected/cost-optimization/set-spending-guardrails.md</data>
