</node>
<node id="Key Vault Extension">
  <data key="d0">Key Vault Extension</data>
  <data key="d1">artifact</data>
  <data key="d2">Key Vault extension is a VM extension available for Windows and Linux that helps protect against threats.</data>
  <data key="d3">chunk-24da17048f52e4eee422a69ff4b58769</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003240</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Antimalware">
  <data key="d0">Microsoft Antimalware</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Antimalware is a security extension for Azure Cloud Services and Virtual Machines.</data>
  <data key="d3">chunk-24da17048f52e4eee422a69ff4b58769</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003240</data>
  <data key="d6"></data>
</node>
<node id="Security Profile">
  <data key="d0">Security Profile</data>
  <data key="d1">concept</data>
  <data key="d2">Security profile is a VM configuration setting that enables security features such as encryption at host, which are automatically applied when the VM is created.</data>
  <data key="d3">chunk-24da17048f52e4eee422a69ff4b58769</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003241</data>
  <data key="d6"></data>
</node>
<node id="Tagging">
  <data key="d0">Tagging</data>
  <data key="d1">method</data>
  <data key="d2">Tagging is a common method to segment and organize Azure resources, crucial during incident management.</data>
  <data key="d3">chunk-24da17048f52e4eee422a69ff4b58769</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003241</data>
  <data key="d6"></data>
</node>
