  <data key="d0">Pull Model</data>
  <data key="d1">method</data>
  <data key="d2">A telemetry collection model where data is collected by a querying component periodically.</data>
  <data key="d3">chunk-7404990d0db645a738f8e03698df0941</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997955</data>
  <data key="d6"></data>
</node>
<node id="Push Model">
  <data key="d0">Push Model</data>
  <data key="d1">method</data>
  <data key="d2">A telemetry collection model where components emit data outward as events occur, including logs, traces, and metrics.</data>
  <data key="d3">chunk-7404990d0db645a738f8e03698df0941</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997955</data>
  <data key="d6"></data>
</node>
<node id="Data Consolidation">
  <data key="d0">Data Consolidation</data>
  <data key="d1">concept</data>
  <data key="d2">Data consolidation involves moving telemetry out of local silos into a central repository, with deduplication, merging, and filtering.</data>
  <data key="d3">chunk-7404990d0db645a738f8e03698df0941</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997956</data>
  <data key="d6"></data>
</node>
<node id="Connection Troubleshoot">
  <data key="d0">Connection Troubleshoot</data>
  <data key="d1">artifact</data>
  <data key="d2">Connection Troubleshoot is a diagnostic tool in Network Watcher providing on-demand diagnostics and packet capture.</data>
  <data key="d3">chunk-71183984350fc59c93d9704f35759a68</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997957</data>
  <data key="d6"></data>
</node>
<node id="Telemetry Pipeline">
  <data key="d0">Telemetry Pipeline</data>
  <data key="d1">concept</data>
  <data key="d2">Telemetry pipelines are scalable, durable systems that handle high-scale data ingestion without bottlenecks or data loss, using buffering, queuing, and redundancy.</data>
  <data key="d3">chunk-71183984350fc59c93d9704f35759a68</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
