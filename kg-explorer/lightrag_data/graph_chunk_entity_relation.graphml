<node id="File Integrity Monitors">
  <data key="d0">File Integrity Monitors</data>
  <data key="d1">concept</data>
  <data key="d2">Security tools that monitor file changes and can cause lock contention if key files are not excluded.&lt;SEP&gt;Security tools that monitor file changes and can cause lock contention if key files are not excluded.</data>
