  <data key="d5">1776996744</data>
  <data key="d6"></data>
</node>
<node id="Network Traffic Flow Classification">
  <data key="d0">Network Traffic Flow Classification</data>
  <data key="d1">method</data>
  <data key="d2">A method of examining workload architecture to understand flow intent, characteristics, and compliance requirements, distinguishing between public and private workloads.</data>
  <data key="d3">chunk-9514c481f519092f6d4362611c52ecde</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996520</data>
  <data key="d6"></data>
</node>
<node id="System Auditing">
  <data key="d0">System Auditing</data>
  <data key="d1">method</data>
  <data key="d2">The practice of maintaining accurate records of system state, tracking resource changes, monitoring configurations, and setting up alerts for unexpected changes.</data>
  <data key="d3">chunk-9514c481f519092f6d4362611c52ecde</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996520</data>
  <data key="d6"></data>
</node>
