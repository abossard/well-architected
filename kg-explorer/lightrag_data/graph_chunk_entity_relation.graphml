  <data key="d6"></data>
</node>
<node id="Cloud HPC">
  <data key="d0">Cloud HPC</data>
  <data key="d1">concept</data>
  <data key="d2">Cloud-based high-performance computing offering burst capacity, variable workloads, rapid provisioning, pay-as-you-go pricing, and on-demand scalability.</data>
  <data key="d3">chunk-f48d0d41fd8e386fc551c0a52af6a632</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006102</data>
  <data key="d6"></data>
</node>
<node id="On-Premises HPC">
  <data key="d0">On-Premises HPC</data>
  <data key="d1">concept</data>
  <data key="d2">On-premises high-performance computing that is cost-effective for predictable, continuous workloads with existing infrastructure.</data>
  <data key="d3">chunk-f48d0d41fd8e386fc551c0a52af6a632</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006102</data>
