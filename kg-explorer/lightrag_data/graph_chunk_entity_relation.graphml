</node>
<node id="Flat Network">
  <data key="d0">Flat Network</data>
  <data key="d1">concept</data>
  <data key="d2">A flat network is a single isolated network topology using subnets for segmentation, suitable for simple multitenant applications.</data>
  <data key="d3">chunk-13a9dd5e331588bd7de29586bf88d3b4</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/networking.md</data>
  <data key="d5">1777004593</data>
