  <data key="d6"></data>
</node>
<node id="ServiceNow">
  <data key="d0">ServiceNow</data>
  <data key="d1">artifact</data>
  <data key="d2">ServiceNow is an incident management system that integrates with Azure Databricks automated notification workflows.&lt;SEP&gt;ServiceNow is an ITSM platform that can be integrated with Azure VMware Solution alerts.&lt;SEP&gt;ServiceNow is an ITSM tool that can be integrated with alerts.</data>
  <data key="d3">chunk-7caf8d0c8419c804f864143fd95c9e90&lt;SEP&gt;chunk-c45aa9611048afab38755ade22af2f4f&lt;SEP&gt;chunk-af15da9f5a57c9361e9e5487fa0eea82</data>
