  <data key="d0">Key Vault VM Extension</data>
  <data key="d1">artifact</data>
  <data key="d2">Key Vault VM extension automatically refreshes certificates stored in a key vault.</data>
  <data key="d3">chunk-52e7efe4d2287af32f723d20849c59c5</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003256</data>
  <data key="d6"></data>
</node>
<node id="Spot Virtual Machines">
  <data key="d0">Spot Virtual Machines</data>
  <data key="d1">concept</data>
  <data key="d2">Spot virtual machines offer deep discounts on compute infrastructure costs but are interruptible, requiring eviction handling.</data>
  <data key="d3">chunk-52e7efe4d2287af32f723d20849c59c5</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003256</data>
  <data key="d6"></data>
</node>
<node id="Scale-In Policy">
  <data key="d0">Scale-In Policy</data>
  <data key="d1">method</data>
  <data key="d2">Scale-in policy reduces the number of VM instances when demand decreases based on defined criteria, saving costs.</data>
  <data key="d3">chunk-52e7efe4d2287af32f723d20849c59c5</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003256</data>
  <data key="d6"></data>
</node>
