</node>
<node id="Workload Health Metrics">
  <data key="d0">Workload Health Metrics</data>
  <data key="d1">data</data>
  <data key="d2">Metrics like CPU, memory usage, and storage usage that reflect workload health status.</data>
  <data key="d3">chunk-bb4be3d9c01e97b5b077710134d8de16</data>
  <data key="d4">well-architected/operational-excellence/maturity-model.md</data>
  <data key="d5">1776997898</data>
