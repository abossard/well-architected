<node id="Event Grid Contributor">
  <data key="d0">Event Grid Contributor</data>
  <data key="d1">concept</data>
  <data key="d2">Event Grid Contributor is a built-in RBAC role assigned to users who manage Event Grid topics and subscriptions.</data>
  <data key="d3">chunk-935a5d6a7d3ef900c2c2a6bad10cdf79</data>
