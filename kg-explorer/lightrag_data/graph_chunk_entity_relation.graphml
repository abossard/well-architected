<node id="Microsoft Foundry Portal">
  <data key="d0">Microsoft Foundry Portal</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Foundry Portal is a model catalog platform available at ai.azure.com for finding pretrained models.&lt;SEP&gt;Microsoft Foundry portal is a platform that offers prompt flow for AI application orchestration.&lt;SEP&gt;Microsoft Foundry Portal provides a model catalog for evaluating curated model collections and deploying models efficiently.</data>
  <data key="d3">chunk-24f18c621ebf65d4f1fbf92e2b662e53&lt;SEP&gt;chunk-1840b694f5e40fc921e2e4772b238961&lt;SEP&gt;chunk-6f31ccebc2a168b87f30309e8394d245</data>
