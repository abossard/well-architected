  <data key="d0">Commitment-Based Discounts</data>
  <data key="d1">concept</data>
  <data key="d2">Discounted resources obtained through prepurchase commitments, prioritized for developing new features or setting up additional environments.</data>
  <data key="d3">chunk-7dfd30e89a4e9aae78702c1f5f2ad501</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/cost-optimization/principles.md</data>
  <data key="d5">1776981521</data>
  <data key="d6"></data>
</node>
<node id="Hybrid Use">
  <data key="d0">Hybrid Use</data>
  <data key="d1">concept</data>
  <data key="d2">A licensing alternative that gives usage rights to the same or comparable technologies at a lower cost without additional licensing.</data>
