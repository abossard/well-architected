  <data key="d5">1777003415</data>
  <data key="d6"></data>
</node>
<node id="Identity Propagation">
  <data key="d0">Identity Propagation</data>
  <data key="d1">method</data>
  <data key="d2">Identity propagation passes group claims or equivalent identity information into knowledge tool calls to prevent unauthorized data retrieval.</data>
  <data key="d3">chunk-6791a2ed934654a8da6b225e44dac9e3</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/application-design.md</data>
  <data key="d5">1777003415</data>
