  <data key="d6"></data>
</node>
<node id="Snapshot Policy">
  <data key="d0">Snapshot Policy</data>
  <data key="d1">concept</data>
  <data key="d2">A policy used to create snapshots to maintain reliability and integrity of applications, with options to hide the snapshot path.</data>
