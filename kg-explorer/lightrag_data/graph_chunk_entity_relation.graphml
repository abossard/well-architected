  <data key="d5">1777002357</data>
  <data key="d6"></data>
</node>
<node id="Cloud Adoption Framework For Azure">
  <data key="d0">Cloud Adoption Framework For Azure</data>
  <data key="d1">concept</data>
  <data key="d2">Cloud Adoption Framework for Azure provides guidance about incident response planning and security operations.&lt;SEP&gt;The Cloud Adoption Framework for Azure provides guidelines and recommendations for tagging and naming Azure resources.&lt;SEP&gt;A framework for standardizing cloud resources and governance in Azure.</data>
  <data key="d3">chunk-c1d20b573314239b2a88ca3deb8586c1&lt;SEP&gt;chunk-298abf3381d05efe7bed040fe109d8ea&lt;SEP&gt;chunk-06d07c7fd7e0ea2028615959913f9c73</data>
