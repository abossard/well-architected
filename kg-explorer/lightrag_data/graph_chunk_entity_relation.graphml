</node>
<node id="Showmount">
  <data key="d0">Showmount</data>
  <data key="d1">concept</data>
  <data key="d2">NFS client functionality that enables users to see exported file systems on an NFS server, which can flag security vulnerabilities.</data>
  <data key="d3">chunk-6cc4795580f532b2b4baa2c23d716389</data>
