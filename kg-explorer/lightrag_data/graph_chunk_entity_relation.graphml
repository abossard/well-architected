  <data key="d5">1777005567</data>
  <data key="d6"></data>
</node>
<node id="Carbon Avoidance">
  <data key="d0">Carbon Avoidance</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon avoidance means not emitting carbon in the first place.</data>
  <data key="d3">chunk-5b8b47369e36bfe734725b284a7694f4</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005567</data>
  <data key="d6"></data>
</node>
<node id="Carbon Removal">
  <data key="d0">Carbon Removal</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon removal involves subtracting carbon from the atmosphere and is the preferred goal for removing emissions.</data>
  <data key="d3">chunk-5b8b47369e36bfe734725b284a7694f4</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005567</data>
  <data key="d6"></data>
</node>
<node id="Green Software">
  <data key="d0">Green Software</data>
  <data key="d1">concept</data>
  <data key="d2">Green software aims to avoid unnecessary emissions in the first place, actively working toward a more sustainable future.&lt;SEP&gt;Green software refers to software designed and operated with environmental sustainability in mind, focusing on carbon efficiency.</data>
  <data key="d3">chunk-5b8b47369e36bfe734725b284a7694f4&lt;SEP&gt;chunk-c2b5d3e99e1ec8118d4d00b53b34fa5b</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-operational-procedures.md</data>
  <data key="d5">1777005674</data>
  <data key="d6"></data>
</node>
<node id="Software Carbon Intensity">
  <data key="d0">Software Carbon Intensity</data>
  <data key="d1">concept</data>
  <data key="d2">Software Carbon Intensity (SCI) is a scoring methodology for measuring the carbon impact of applications, calculated as ((E*I)+M) per R.&lt;SEP&gt;Software Carbon Intensity (SCI) is a score that measures the carbon impact of applications by adding scalability and cost metrics to carbon emissions measurement.&lt;SEP&gt;Software Carbon Intensity (SCI) is a metric for measuring carbon emissions of software, which can use carbon proxies when specific standards are lacking.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2&lt;SEP&gt;chunk-de9afa79a4fdffd13927a0fd86422a26&lt;SEP&gt;chunk-4ffbcaed09a6238f67fd871fe98e0fb8</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-operational-procedures.md</data>
  <data key="d5">1777005671</data>
  <data key="d6"></data>
</node>
<node id="Greenhouse Gas Protocol">
  <data key="d0">Greenhouse Gas Protocol</data>
  <data key="d1">concept</data>
  <data key="d2">The Greenhouse Gas Protocol is a standard for categorizing greenhouse gas emissions into three scopes.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005568</data>
  <data key="d6"></data>
</node>
<node id="Azure Carbon Optimization">
  <data key="d0">Azure Carbon Optimization</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Carbon Optimization is an Azure service providing granular emissions data and insights to optimize cloud workloads for sustainability.&lt;SEP&gt;Azure Carbon Optimization provides access to real-time carbon intensity data for scheduling training workloads.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2&lt;SEP&gt;chunk-c5dafaf64829c3146ac17935b49a986e</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
  <data key="d5">1777005823</data>
  <data key="d6"></data>
</node>
<node id="Scope 1 Emissions">
  <data key="d0">Scope 1 Emissions</data>
  <data key="d1">concept</data>
  <data key="d2">Scope 1 emissions are direct emissions created by an organization's activities.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005568</data>
  <data key="d6"></data>
</node>
<node id="Scope 2 Emissions">
  <data key="d0">Scope 2 Emissions</data>
  <data key="d1">concept</data>
  <data key="d2">Scope 2 emissions are indirect emissions from production of electricity or heat used.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005568</data>
  <data key="d6"></data>
</node>
<node id="Scope 3 Emissions">
  <data key="d0">Scope 3 Emissions</data>
  <data key="d1">concept</data>
  <data key="d2">Scope 3 emissions are indirect emissions from supply chain, materials, travel, and product life cycles, often far exceeding Scope 1 and 2 combined.</data>
  <data key="d3">chunk-582be1ccb87862d2378d13bad31c21e2</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-design-methodology.md</data>
  <data key="d5">1777005568</data>
  <data key="d6"></data>
</node>
<node id="SCI Equation">
  <data key="d0">SCI Equation</data>
  <data key="d1">method</data>
  <data key="d2">The SCI equation aims to eliminate emissions and its score can only be reduced with abatement.</data>
  <data key="d3">chunk-467c7e51d8f6452fcd14acfb1b838b59</data>
