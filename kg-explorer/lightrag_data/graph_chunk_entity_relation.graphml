<node id="User Story">
  <data key="d0">User Story</data>
  <data key="d1">concept</data>
  <data key="d2">A user story is a standardized template for capturing discrete units of work from the user's perspective, following principles of being independent, negotiable, valuable, estimable, and testable.</data>
  <data key="d3">chunk-7c1c379f7c96adb8c669329b1ce128b9</data>
