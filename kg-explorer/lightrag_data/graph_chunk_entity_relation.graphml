</node>
<node id="Public Sources">
  <data key="d0">Public Sources</data>
  <data key="d1">concept</data>
  <data key="d2">Public sources are data accessible to anyone, including websites, research papers, and publicly shared databases.</data>
  <data key="d3">chunk-188c7778d5d303d397f8ab1d39a109c6</data>
