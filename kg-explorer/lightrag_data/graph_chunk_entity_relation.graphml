  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
  <data key="d5">1777005826</data>
  <data key="d6"></data>
</node>
<node id="Comprehensive Monitoring Strategy">
  <data key="d0">Comprehensive Monitoring Strategy</data>
  <data key="d1">concept</data>
  <data key="d2">A comprehensive monitoring strategy tracks data drift, performance, and sustainability metrics to avoid wasting machine learning operations cycles.</data>
  <data key="d3">chunk-5c9960b8b9c51b110df1728d769e8cad</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
  <data key="d5">1777005826</data>
  <data key="d6"></data>
