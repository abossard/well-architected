</node>
<node id="Operational Costs">
  <data key="d0">Operational Costs</data>
  <data key="d1">concept</data>
  <data key="d2">Operational costs are ongoing expenses for monitoring, testing, and maintenance of infrastructure.</data>
  <data key="d3">chunk-1f082730bb91f06b04e3b6f39138f774</data>
  <data key="d4">well-architected/cost-optimization/cost-model.md</data>
  <data key="d5">1776998340</data>
