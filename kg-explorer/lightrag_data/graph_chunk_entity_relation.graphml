  <data key="d0">Performance Recommendations</data>
  <data key="d1">artifact</data>
  <data key="d2">Performance Recommendations is a tool in Azure SQL Database for finding optimization recommendations via the database advisor portal.</data>
  <data key="d3">chunk-4a363f9bc0a4fd35ef60bc7f3c1bce53</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-sql-database.md</data>
  <data key="d5">1777002637</data>
