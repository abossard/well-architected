  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996411</data>
  <data key="d6"></data>
</node>
<node id="Group Access Management">
  <data key="d0">Group Access Management</data>
  <data key="d1">concept</data>
  <data key="d2">Group access management involves assigning access to groups in Microsoft Entra ID instead of specific users, allowing centralized permission management.</data>
  <data key="d3">chunk-0af9b59bcc2e38e219c04c0496ed334e</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996411</data>
  <data key="d6"></data>
</node>
<node id="Azure Diagnostics">
  <data key="d0">Azure Diagnostics</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Diagnostics enables access logs across identity components in Azure resources.</data>
  <data key="d3">chunk-0af9b59bcc2e38e219c04c0496ed334e</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996411</data>
  <data key="d6"></data>
</node>
<node id="System-Managed Identities">
  <data key="d0">System-Managed Identities</data>
  <data key="d1">concept</data>
  <data key="d2">System-managed identities are provided by Microsoft Entra ID for access to service data planes and Azure management plane control via RBAC.</data>
  <data key="d3">chunk-0af9b59bcc2e38e219c04c0496ed334e</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996411</data>
  <data key="d6"></data>
</node>
<node id="Human Identities">
  <data key="d0">Human Identities</data>
  <data key="d1">concept</data>
  <data key="d2">Human identities represent user and operator authentication delegated to Microsoft Entra ID, including native, B2B, or B2C scenarios.</data>
  <data key="d3">chunk-0af9b59bcc2e38e219c04c0496ed334e</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996411</data>
