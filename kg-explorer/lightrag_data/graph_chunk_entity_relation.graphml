<node id="PE:08">
  <data key="d0">PE:08</data>
  <data key="d1">method</data>
  <data key="d2">PE:08 recommends optimizing data stores, partitions, and indexes for their intended use.</data>
  <data key="d3">chunk-aabe428ecc28c763c7d768871230b9a3</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/performance-efficiency/checklist.md</data>
  <data key="d5">1776981288</data>
  <data key="d6"></data>
</node>
<node id="PE:09">
  <data key="d0">PE:09</data>
  <data key="d1">method</data>
  <data key="d2">PE:09 recommends prioritizing performance of critical flows that support the most important business processes.</data>
  <data key="d3">chunk-aabe428ecc28c763c7d768871230b9a3</data>
