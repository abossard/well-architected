  <data key="d6"></data>
</node>
<node id="Azure DDoS Protection Basic">
  <data key="d0">Azure DDoS Protection Basic</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure DDoS Protection Basic provides baseline DDoS attack protection for Azure Front Door application endpoints.&lt;SEP&gt;Azure DDoS Protection Basic is integrated into Azure Front Door by default, providing always-on traffic monitoring and real-time mitigation.&lt;SEP&gt;Azure DDoS Protection Basic provides baseline DDoS attack protection for Azure Front Door application endpoints.&lt;SEP&gt;Azure DDoS Protection Basic is integrated into Azure Front Door by default, providing always-on traffic monitoring and real-time mitigation.</data>
  <data key="d3">chunk-ce015784fd1d8129dac8c9bbf32bf565&lt;SEP&gt;chunk-a6ee1b46c13062b2f84bc4bd8740f6c3</data>
