  <data key="d5">1777004471</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Power BI">
  <data key="d0">Microsoft Power BI</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Power BI is a tool for collecting, reviewing, and analyzing cost data, integrating with Cost Management to import cost data.&lt;SEP&gt;Microsoft Power BI is a reporting tool that can be used to build reports as an alternative to direct data access.&lt;SEP&gt;Microsoft Power BI is a reporting tool that can be used as an application-tier approach to provide data access to customers.</data>
  <data key="d3">chunk-a0be076c15399d472d831cac4c767ef8&lt;SEP&gt;chunk-47ab26c52b0edef6c01bfe85ba5744e8&lt;SEP&gt;chunk-af77fdbd68a5283ca0d7625c8716f1b1</data>
