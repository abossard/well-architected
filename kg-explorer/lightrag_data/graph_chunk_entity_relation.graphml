</node>
<node id="Workload Operations">
  <data key="d0">Workload Operations</data>
  <data key="d1">content</data>
  <data key="d2">Workload operations covers modernizing operational practices with new approaches and specialized roles and training.</data>
  <data key="d3">chunk-0144ba584fc445d0829602eb838085c0</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/get-started.md</data>
