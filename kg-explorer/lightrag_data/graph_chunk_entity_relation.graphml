<node id="Secret Exposure Detection">
  <data key="d0">Secret Exposure Detection</data>
  <data key="d1">concept</data>
  <data key="d2">Secret exposure detection involves integrating processes to detect suspicious activity and periodically check for exposed keys in application code.</data>
  <data key="d3">chunk-31026fe6d1c4bec43b15c40b1c162e07</data>
  <data key="d4">well-architected/security/application-secrets.md</data>
  <data key="d5">1776996118</data>
