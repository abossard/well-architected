  <data key="d5">1777003903</data>
  <data key="d6"></data>
</node>
<node id="Innovation Days">
  <data key="d0">Innovation Days</data>
  <data key="d1">method</data>
  <data key="d2">Innovation days are structured events allowing teams to focus on pre-selected improvement projects to foster fresh ideas and experimentation.</data>
  <data key="d3">chunk-85dfff44e8e4c1e2d34f3f2fbc239ab2</data>
