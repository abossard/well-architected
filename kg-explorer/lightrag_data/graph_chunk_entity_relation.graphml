  <data key="d6"></data>
</node>
<node id="Usage Details API">
  <data key="d0">Usage Details API</data>
  <data key="d1">artifact</data>
  <data key="d2">Usage Details API provides programmatic retrieval of raw, unaggregated cost data corresponding to an Azure bill.</data>
  <data key="d3">chunk-a0be076c15399d472d831cac4c767ef8</data>
