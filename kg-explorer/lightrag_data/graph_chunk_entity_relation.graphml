  <data key="d5">1776996741</data>
  <data key="d6"></data>
</node>
<node id="Principle Of Least Access">
  <data key="d0">Principle Of Least Access</data>
  <data key="d1">concept</data>
  <data key="d2">A security principle where permissions are granted at the minimum level necessary.</data>
  <data key="d3">chunk-50e84f8f3385ed4e029dfd1f75a5fc3e</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996516</data>
  <data key="d6"></data>
