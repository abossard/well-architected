  <data key="d5">1776998682</data>
  <data key="d6"></data>
</node>
<node id="Data Profiling">
  <data key="d0">Data Profiling</data>
  <data key="d1">method</data>
  <data key="d2">Data profiling involves examining data from a source to understand its quality, structure, and characteristics, identifying issues like missing values and duplicates.</data>
  <data key="d3">chunk-dcd9326bd28e1ca67beb40e575a0abd3</data>
  <data key="d4">well-architected/performance-efficiency/optimize-data-performance.md</data>
  <data key="d5">1776997230</data>
  <data key="d6"></data>
</node>
<node id="Query Tuning">
  <data key="d0">Query Tuning</data>
  <data key="d1">method</data>
  <data key="d2">Query tuning is a process that optimizes the speed of a database query.</data>
  <data key="d3">chunk-dcd9326bd28e1ca67beb40e575a0abd3</data>
  <data key="d4">well-architected/performance-efficiency/optimize-data-performance.md</data>
  <data key="d5">1776997230</data>
  <data key="d6"></data>
</node>
<node id="Read Replica">
  <data key="d0">Read Replica</data>
  <data key="d1">concept</data>
  <data key="d2">A read replica is a live copy of a primary database that enables offloading read traffic from a write database.</data>
  <data key="d3">chunk-dcd9326bd28e1ca67beb40e575a0abd3</data>
  <data key="d4">well-architected/performance-efficiency/optimize-data-performance.md</data>
