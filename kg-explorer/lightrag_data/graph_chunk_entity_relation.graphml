<node id="Data Plane Access">
  <data key="d0">Data Plane Access</data>
  <data key="d1">concept</data>
  <data key="d2">Data plane access involves actions that cause data transfer for inside-out or outside-in access.</data>
  <data key="d3">chunk-3ea57e7a575650ba4d31b8ba51cf8991</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996407</data>
