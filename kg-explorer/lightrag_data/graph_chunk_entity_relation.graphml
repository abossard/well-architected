  <data key="d0">Azure Cosmos DB Emulator</data>
  <data key="d1">artifact</data>
  <data key="d2">The Azure Cosmos DB emulator reduces costs for dev/test and continuous integration use cases, available as a Docker container image.</data>
  <data key="d3">chunk-6e48c686ed9dcbf1ebc4bd457a81b5e7</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/cosmos-db.md</data>
  <data key="d5">1777003081</data>
  <data key="d6"></data>
</node>
<node id="Transactional Batch Operations">
  <data key="d0">Transactional Batch Operations</data>
  <data key="d1">method</data>
  <data key="d2">Transactional batch operations allow inserting, updating, or deleting multiple documents in a single transaction request within a logical partition.</data>
  <data key="d3">chunk-6e48c686ed9dcbf1ebc4bd457a81b5e7</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/cosmos-db.md</data>
  <data key="d5">1777003082</data>
  <data key="d6"></data>
</node>
