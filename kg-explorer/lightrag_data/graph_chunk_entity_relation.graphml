</node>
<node id="PE:03">
  <data key="d0">PE:03</data>
  <data key="d1">method</data>
  <data key="d2">PE:03 recommends selecting the right services, infrastructure, and tier selections to support performance targets and expected capacity changes.</data>
  <data key="d3">chunk-aabe428ecc28c763c7d768871230b9a3</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/performance-efficiency/checklist.md</data>
