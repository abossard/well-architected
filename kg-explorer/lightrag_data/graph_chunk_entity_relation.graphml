  <data key="d5">1777006205</data>
  <data key="d6"></data>
</node>
<node id="Private Clusters">
  <data key="d0">Private Clusters</data>
  <data key="d1">concept</data>
  <data key="d2">Private clusters are a foundational AKS configuration option that cannot be changed without re-deploying the cluster.</data>
  <data key="d3">chunk-1c97b53f9c2bcaf2eaf8ee6eff46b6b2</data>
