  <data key="d3">chunk-7277d28a361465235f16e5be124c32d9</data>
  <data key="d4">well-architected/security/incident-response.md</data>
  <data key="d5">1776996449</data>
  <data key="d6"></data>
</node>
<node id="SOC">
  <data key="d0">SOC</data>
  <data key="d1">concept</data>
  <data key="d2">SOC (Security Operations Center) is a concept related to security operations as described by Microsoft.</data>
