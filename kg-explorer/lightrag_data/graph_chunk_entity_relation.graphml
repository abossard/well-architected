  <data key="d6"></data>
</node>
<node id="Cluster Life Cycle Policies">
  <data key="d0">Cluster Life Cycle Policies</data>
  <data key="d1">method</data>
  <data key="d2">Cluster life cycle policies include automated termination schedules, idle timeout configurations, and resource usage limits for governance.</data>
  <data key="d3">chunk-7caf8d0c8419c804f864143fd95c9e90</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-databricks.md</data>
