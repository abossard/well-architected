<node id="High Performance Computing">
  <data key="d0">High Performance Computing</data>
  <data key="d1">concept</data>
  <data key="d2">High Performance Computing (HPC) solves compute-intensive problems by running tasks across clusters of machines in parallel.</data>
  <data key="d3">chunk-9d92f2138a13f47ba741d8618d3160dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-methodology.md</data>
  <data key="d5">1777006153</data>
  <data key="d6"></data>
</node>
<node id="Tightly Coupled">
  <data key="d0">Tightly Coupled</data>
  <data key="d1">concept</data>
  <data key="d2">A coupling pattern where tasks communicate frequently and run in lockstep, requiring low-latency, high-bandwidth networking.</data>
  <data key="d3">chunk-9d92f2138a13f47ba741d8618d3160dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-methodology.md</data>
  <data key="d5">1777006153</data>
  <data key="d6"></data>
</node>
<node id="Loosely Coupled">
  <data key="d0">Loosely Coupled</data>
  <data key="d1">concept</data>
  <data key="d2">A coupling pattern where tasks run independently or communicate infrequently, allowing standard networking and cost-efficient resources.</data>
  <data key="d3">chunk-9d92f2138a13f47ba741d8618d3160dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-methodology.md</data>
  <data key="d5">1777006153</data>
  <data key="d6"></data>
</node>
