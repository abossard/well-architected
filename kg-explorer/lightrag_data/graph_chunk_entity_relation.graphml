</node>
<node id="KPIs">
  <data key="d0">KPIs</data>
  <data key="d1">concept</data>
  <data key="d2">Key Performance Indicators are measurable values showing how effectively a workload achieves business and operational objectives.</data>
  <data key="d3">chunk-44db748d8a4a0feea6626c78c05321a2</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997959</data>
  <data key="d6"></data>
</node>
<node id="APM">
  <data key="d0">APM</data>
  <data key="d1">concept</data>
  <data key="d2">Application Performance Management tools and practices for monitoring application performance, availability, and user experience.&lt;SEP&gt;Application Performance Management tools that automatically capture telemetry from applications including request rates, failure rates, and distributed traces.</data>
  <data key="d3">chunk-44db748d8a4a0feea6626c78c05321a2&lt;SEP&gt;chunk-564e02afbba673b81e1950dcf16d845f</data>
  <data key="d4">well-architected/operational-excellence/observability.md&lt;SEP&gt;well-architected/design-guides/monitoring.md</data>
  <data key="d5">1776999382</data>
  <data key="d6"></data>
</node>
<node id="Instrumentation">
  <data key="d0">Instrumentation</data>
  <data key="d1">method</data>
  <data key="d2">Adding monitoring capabilities to applications and infrastructure to capture telemetry, including logging, metrics collection, and tracing.&lt;SEP&gt;The process of embedding code or tools in source to generate operational signals called telemetry.&lt;SEP&gt;Instrumentation is the practice of adding telemetry tracking to applications and infrastructure to capture operational signals like logs, traces, and metrics.</data>
  <data key="d3">chunk-44db748d8a4a0feea6626c78c05321a2&lt;SEP&gt;chunk-564e02afbba673b81e1950dcf16d845f&lt;SEP&gt;chunk-520b008ac150d01d52152b172f0a59b4</data>
