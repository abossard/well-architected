  <data key="d5">1777001159</data>
  <data key="d6"></data>
</node>
<node id="Sentinel">
  <data key="d0">Sentinel</data>
  <data key="d1">artifact</data>
  <data key="d2">A standardized Java package for implementing resiliency patterns.&lt;SEP&gt;Sentinel is a security service that extends free data retention in Log Analytics workspace to 90 days when enabled.</data>
  <data key="d3">chunk-36d66c785cc9b10b4cf377888b6bd59f&lt;SEP&gt;chunk-1bc4a6aa7dad91160ab49f8c99c2ea47</data>
