  <data key="d0">Microsoft Defender For Cloud</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Defender for Cloud, formerly Azure Security Center, is a security service enabled for subscriptions containing mission-critical workload resources.&lt;SEP&gt;Microsoft Defender for Cloud, formerly known as Azure Security Center, is a security information and event management solution.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf&lt;SEP&gt;chunk-0151994e0d96a2045a761ce543e6d2a3</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980099</data>
  <data key="d6"></data>
</node>
<node id="Azure Defender">
  <data key="d0">Azure Defender</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Defender is a security capability enabled for supporting services.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980099</data>
  <data key="d6"></data>
</node>
<node id="Threat Modeling">
  <data key="d0">Threat Modeling</data>
  <data key="d1">method</data>
  <data key="d2">Threat modeling provides a risk-based approach to security design using identified potential threats to develop security mitigations.&lt;SEP&gt;Threat modeling is a method to identify and mitigate potential threats, producing a report of attack vectors prioritized by severity.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf&lt;SEP&gt;chunk-a51316135aacca9fd878154c3dd2abcf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/security/principles.md</data>
  <data key="d5">1776981156</data>
  <data key="d6"></data>
</node>
<node id="STRIDE">
  <data key="d0">STRIDE</data>
  <data key="d1">method</data>
  <data key="d2">STRIDE is a lightweight risk framework for evaluating security threats across key threat vectors including spoofing, tampering, repudiation, information disclosure, denial of service, and elevation of privilege.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980100</data>
  <data key="d6"></data>
</node>
<node id="Defense-In-Depth">
  <data key="d0">Defense-In-Depth</data>
  <data key="d1">concept</data>
  <data key="d2">Defense-in-depth is a layered security approach applied to define and implement compensating mitigations for modeled threats.&lt;SEP&gt;A security principle applied by using localized network controls at all available network boundaries.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf&lt;SEP&gt;chunk-0d8a1fa2cefd5c5b3095c48727dd166b</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/security/checklist.md</data>
  <data key="d5">1776981193</data>
  <data key="d6"></data>
</node>
<node id="Azure Private Endpoints">
  <data key="d0">Azure Private Endpoints</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Private Endpoints are private endpoints that provide secure, private access to Azure PaaS resources.</data>
  <data key="d3">chunk-9406ed2aa903d9c51a1e6e1d68aee2dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980100</data>
  <data key="d6"></data>
</node>
<node id="Virtual Network Service Endpoints">
  <data key="d0">Virtual Network Service Endpoints</data>
  <data key="d1">artifact</data>
  <data key="d2">Virtual Network Service Endpoints provide service-level access from selected subnets to selected PaaS services.</data>
  <data key="d3">chunk-9406ed2aa903d9c51a1e6e1d68aee2dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980101</data>
  <data key="d6"></data>
</node>
