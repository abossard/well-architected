  <data key="d0">Federated Identities</data>
  <data key="d1">method</data>
  <data key="d2">Federated identities allow users to sign in with existing credentials maintained by another identity provider such as Google, Facebook, LinkedIn, Microsoft Entra, or Okta.</data>
