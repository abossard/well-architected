  <data key="d5">1776998945</data>
  <data key="d6"></data>
</node>
<node id="Forecast Alerts">
  <data key="d0">Forecast Alerts</data>
  <data key="d1">concept</data>
  <data key="d2">Automated alerts generated when forecasted spending trends are likely to exceed the budget.</data>
  <data key="d3">chunk-02ed72abe4ca2d3a3487f2b3c4c1bb89</data>
