</node>
<node id="SHO">
  <data key="d0">SHO</data>
  <data key="d1">concept</data>
  <data key="d2">Service Health Objectives capture the health to be attained over an aggregated time range.&lt;SEP&gt;Service Health Objectives capture the health to be attained over an aggregated time range.</data>
