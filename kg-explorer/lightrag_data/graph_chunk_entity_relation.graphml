  <data key="d0">Query Performance Insights</data>
  <data key="d1">artifact</data>
  <data key="d2">Query Performance Insights is a tool for optimizing queries, tables, and databases in Azure SQL Database.</data>
  <data key="d3">chunk-65d6d67b4e65531ad950d1206265e623</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
