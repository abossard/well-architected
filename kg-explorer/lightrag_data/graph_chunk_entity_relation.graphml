  <data key="d5">1777000524</data>
  <data key="d6"></data>
</node>
<node id="Multi-Zone Architecture">
  <data key="d0">Multi-Zone Architecture</data>
  <data key="d1">concept</data>
  <data key="d2">Multi-zone architecture involves deploying zone-redundant components within a region, and can be combined with multi-region approaches.&lt;SEP&gt;Multi-zone architecture involves deploying zone-redundant components within a region, and can be combined with multi-region approaches.</data>
  <data key="d3">chunk-e92839392c86e80753e5e62c70459c56</data>
