  <data key="d6"></data>
</node>
<node id="Power BI">
  <data key="d0">Power BI</data>
  <data key="d1">artifact</data>
  <data key="d2">Power BI is a Microsoft data visualization technology mentioned as one of several options for visualizing operational data.</data>
  <data key="d3">chunk-09511819f8c1ba5a16e71983efd9f8b7</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-health-modeling.md</data>
  <data key="d5">1776979825</data>
