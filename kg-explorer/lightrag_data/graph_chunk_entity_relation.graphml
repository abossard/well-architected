  <data key="d6"></data>
</node>
<node id="Dead-Letter Queue Pattern">
  <data key="d0">Dead-Letter Queue Pattern</data>
  <data key="d1">concept</data>
  <data key="d2">Dead-letter queue pattern is a messaging pattern for handling messages that cannot be delivered or processed.</data>
  <data key="d3">chunk-6fbfe826fe19c233eb2d1b279f7950e7</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999215</data>
  <data key="d6"></data>
</node>
<node id="Playwright">
  <data key="d0">Playwright</data>
  <data key="d1">artifact</data>
  <data key="d2">Playwright is a testing framework that supports network mocking for testing web application resiliency.</data>
  <data key="d3">chunk-cb8602faa58c6ec0ac39453f0668455f</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999215</data>
  <data key="d6"></data>
</node>
<node id="Telemetry And Monitoring System">
  <data key="d0">Telemetry And Monitoring System</data>
  <data key="d1">concept</data>
  <data key="d2">A telemetry and monitoring system raises alerts when failure rates, average retries, or elapsed operation times increase beyond acceptable levels.</data>
  <data key="d3">chunk-cb8602faa58c6ec0ac39453f0668455f</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999215</data>
  <data key="d6"></data>
</node>
<node id="Throttling Errors">
  <data key="d0">Throttling Errors</data>
  <data key="d1">concept</data>
  <data key="d2">Throttling errors indicate a design flaw in the application or the need to switch to a premium service with dedicated hardware.</data>
  <data key="d3">chunk-cb8602faa58c6ec0ac39453f0668455f</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999216</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Edge Devtools">
  <data key="d0">Microsoft Edge Devtools</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Edge DevTools provides the ability to block network requests for testing web application resiliency.</data>
  <data key="d3">chunk-cb8602faa58c6ec0ac39453f0668455f</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999216</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Assessments">
  <data key="d0">Microsoft Assessments</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Assessments is a platform that hosts multiple assessments applying the Well-Architected Framework perspective to various technologies and workloads.</data>
  <data key="d3">chunk-6200584afd66d7b2ca01f9fe20d183ee</data>
