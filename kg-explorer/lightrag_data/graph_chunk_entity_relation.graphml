  <data key="d5">1777002992</data>
  <data key="d6"></data>
</node>
<node id="Network Ingress Security">
  <data key="d0">Network Ingress Security</data>
  <data key="d1">concept</data>
  <data key="d2">Securing network ingress points as the first line of defense against outside attackers.</data>
  <data key="d3">chunk-50e84f8f3385ed4e029dfd1f75a5fc3e</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996514</data>
  <data key="d6"></data>
</node>
<node id="Attack Surface Hardening">
  <data key="d0">Attack Surface Hardening</data>
  <data key="d1">concept</data>
  <data key="d2">An iterative process of analyzing and reducing workload vulnerabilities through continuous improvement.</data>
  <data key="d3">chunk-50e84f8f3385ed4e029dfd1f75a5fc3e</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
