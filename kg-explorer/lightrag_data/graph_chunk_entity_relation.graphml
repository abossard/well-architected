<node id="Client Side Routing Logic">
  <data key="d0">Client Side Routing Logic</data>
  <data key="d1">method</data>
  <data key="d2">Client-side logic that handles failover scenarios when the primary global routing technology fails, routing to redundant technology.&lt;SEP&gt;Client-side logic that handles failover scenarios when the primary global routing technology fails, routing to redundant technology.</data>
  <data key="d3">chunk-38a9b32aa690001ea5387c320074295c</data>
