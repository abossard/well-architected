  <data key="d1">artifact</data>
  <data key="d2">GitHub Advanced Security is a security toolset for finding credentials in source code and tracking security scores.</data>
  <data key="d3">chunk-abf9fd57985f14c81b7d1b9d2924d1bc</data>
  <data key="d4">well-architected/security/secure-development-lifecycle.md</data>
