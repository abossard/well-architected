  <data key="d0">Privileged Access Workstation</data>
  <data key="d1">concept</data>
  <data key="d2">A dedicated and secure machine used to perform sensitive tasks, reducing the risk of compromise.</data>
  <data key="d3">chunk-6f8c5639aa16c2329aa96771580d1b65</data>
  <data key="d4">well-architected/security/harden-resources.md</data>
  <data key="d5">1776996333</data>
