  <data key="d6"></data>
</node>
<node id="HTAP">
  <data key="d0">HTAP</data>
  <data key="d1">concept</data>
  <data key="d2">Hybrid Transactional-Analytical Processing (HTAP) enables querying transactional data for analytics in near real-time without ETL.</data>
