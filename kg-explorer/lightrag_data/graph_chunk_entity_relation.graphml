  <data key="d6"></data>
</node>
<node id="OWASP">
  <data key="d0">OWASP</data>
  <data key="d1">organization</data>
  <data key="d2">OWASP defines the top 10 web vulnerabilities that Azure WAF protects against using managed rule sets.&lt;SEP&gt;OWASP defines the top 10 web vulnerabilities that Azure WAF protects against using managed rule sets.</data>
