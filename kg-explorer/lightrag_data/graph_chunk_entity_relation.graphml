</edge>
<edge source="Performance Efficiency" target="Over-Provisioning">
  <data key="d7">1.0</data>
  <data key="d8">Over-provisioning for reliability counters performance efficiency goals by using more resources than demand requires.</data>
  <data key="d9">resource waste,tradeoff</data>
