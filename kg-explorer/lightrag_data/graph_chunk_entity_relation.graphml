  <data key="d1">content</data>
  <data key="d2">A foundational reference architecture demonstrating key recommendations for App Service with zone-redundant deployment.</data>
  <data key="d3">chunk-b48af37296dffdbb0c217dfd4ed7f1e4</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/app-service-web-apps.md</data>
  <data key="d5">1777000139</data>
  <data key="d6"></data>
</node>
<node id="Easy Auth">
  <data key="d0">Easy Auth</data>
  <data key="d1">concept</data>
  <data key="d2">App Service built-in authentication, also known as Easy Auth, verifies incoming requests.</data>
  <data key="d3">chunk-b48af37296dffdbb0c217dfd4ed7f1e4</data>
