  <data key="d5">1777002857</data>
  <data key="d6"></data>
</node>
<node id="Heat Map REST API">
  <data key="d0">Heat Map REST API</data>
  <data key="d1">method</data>
  <data key="d2">The Heat Map REST API provides data about client locations and latency, offering flexibility for custom tooling and integration with external tools.&lt;SEP&gt;A REST API for analyzing traffic performance in Traffic Manager.</data>
  <data key="d3">chunk-2230ce3d7cb1e253eb90d2592e57fab1&lt;SEP&gt;chunk-a8c2320d6f192d51ba7461cdb73ef6e1</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-traffic-manager.md</data>
  <data key="d5">1777002857</data>
  <data key="d6"></data>
</node>
<node id="Diagnostic Logs">
  <data key="d0">Diagnostic Logs</data>
  <data key="d1">data</data>
  <data key="d2">Diagnostic logs provide insights about the behavior of Traffic Manager profiles, including reasons for individual probe time-outs against endpoints.</data>
  <data key="d3">chunk-2230ce3d7cb1e253eb90d2592e57fab1</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-traffic-manager.md</data>
  <data key="d5">1777002858</data>
