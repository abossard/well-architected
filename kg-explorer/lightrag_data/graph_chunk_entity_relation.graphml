</node>
<node id="Evaluation Data">
  <data key="d0">Evaluation Data</data>
  <data key="d1">concept</data>
  <data key="d2">Evaluation data is a subset of source data used to monitor and validate model performance during training and guide hyperparameter tuning.</data>
  <data key="d3">chunk-d88dee01d0a30636bf4119d50523dfef</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/training-data-design.md</data>
