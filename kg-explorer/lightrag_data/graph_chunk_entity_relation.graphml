  <data key="d5">1777002978</data>
  <data key="d6"></data>
</node>
<node id="Secured Virtual Hub">
  <data key="d0">Secured Virtual Hub</data>
  <data key="d1">artifact</data>
  <data key="d2">A secured virtual hub is a Virtual WAN hub configured to inspect traffic centrally using Azure Firewall or partner NVAs.</data>
