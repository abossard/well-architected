  <data key="d5">1776983280</data>
  <data key="d6"></data>
</node>
<node id="TLS">
  <data key="d0">TLS</data>
  <data key="d1">concept</data>
  <data key="d2">TLS (Transport Layer Security) is a protocol for secure connections, managed via Azure Front Door's managed certificate service.&lt;SEP&gt;TLS (Transport Layer Security) is used for encrypted connections such as HTTPS from the TLS offloading point to application backends.&lt;SEP&gt;TLS (Transport Layer Security) is a protocol for secure connections, managed via Azure Front Door's managed certificate service.&lt;SEP&gt;TLS (Transport Layer Security) is used for encrypted connections such as HTTPS from the TLS offloading point to application backends.</data>
