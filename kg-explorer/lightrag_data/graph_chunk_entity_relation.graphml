  <data key="d5">1777005394</data>
  <data key="d6"></data>
</node>
<node id="Jira">
  <data key="d0">Jira</data>
  <data key="d1">artifact</data>
  <data key="d2">Jira is an incident management system that integrates with Azure Databricks automated notification workflows.</data>
  <data key="d3">chunk-7caf8d0c8419c804f864143fd95c9e90</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-databricks.md</data>
  <data key="d5">1777000949</data>
