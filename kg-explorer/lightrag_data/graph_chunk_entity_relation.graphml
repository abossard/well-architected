</node>
<node id="Data Team">
  <data key="d0">Data Team</data>
  <data key="d1">organization</data>
  <data key="d2">The data team is a stakeholder in the collect telemetry flow and provides on-call engineering support.&lt;SEP&gt;The Data Team is a stakeholder for User Flow 3 and involved in escalation paths.</data>
  <data key="d3">chunk-e5bf352261b44afadc521c1b327650cc&lt;SEP&gt;chunk-a2611a82124cb2d05996b048b560df89</data>
