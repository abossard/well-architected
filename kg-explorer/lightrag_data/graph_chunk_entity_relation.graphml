<node id="Enterprise Identity">
  <data key="d0">Enterprise Identity</data>
  <data key="d1">concept</data>
  <data key="d2">Enterprise identity is the identity solution used to authenticate internal users and workloads to business productivity tools, internal tools or services, and Azure services.</data>
  <data key="d3">chunk-c20cbaa5ca63eea5db965095af5d2c3b</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/identity-access.md</data>
