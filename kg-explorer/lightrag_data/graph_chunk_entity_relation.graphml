  <data key="d0">Azure Firewall Premium</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Firewall Premium supports deep packet inspection and TLS inspection for in-line network security requirements.</data>
  <data key="d3">chunk-9406ed2aa903d9c51a1e6e1d68aee2dc</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1776980101</data>
  <data key="d6"></data>
</node>
<node id="Application Security Groups">
  <data key="d0">Application Security Groups</data>
  <data key="d1">artifact</data>
  <data key="d2">Application Security Groups are used to micro-segment application traffic but don't span across multiple virtual networks.</data>
