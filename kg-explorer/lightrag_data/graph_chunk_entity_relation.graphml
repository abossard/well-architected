  <data key="d5">1777005468</data>
  <data key="d6"></data>
</node>
<node id="VMware HCX">
  <data key="d0">VMware HCX</data>
  <data key="d1">artifact</data>
  <data key="d2">VMware HCX is an optional migration and connectivity component with a roundtrip latency requirement of less than 150 ms.&lt;SEP&gt;VMware HCX is a VMware tool used for workload migration and management.</data>
  <data key="d3">chunk-d2316cc990e8eb48dc944c11d4a38990&lt;SEP&gt;chunk-9cfb7bf32559f95cd49b57ae0a4db207</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/infrastructure.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/overview.md</data>
  <data key="d5">1777005432</data>
  <data key="d6"></data>
</node>
