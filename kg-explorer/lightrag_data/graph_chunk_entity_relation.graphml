</node>
<node id="Microsoft.Insights REST API">
  <data key="d0">Microsoft.Insights REST API</data>
  <data key="d1">artifact</data>
  <data key="d2">The Microsoft.Insights REST API is used to deploy query packs as Azure Resource Manager resources.</data>
  <data key="d3">chunk-1bc4a6aa7dad91160ab49f8c99c2ea47</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-health-modeling.md</data>
  <data key="d5">1776979833</data>
