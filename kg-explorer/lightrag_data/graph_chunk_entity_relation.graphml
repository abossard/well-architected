  <data key="d5">1777003254</data>
  <data key="d6"></data>
</node>
<node id="NVMe">
  <data key="d0">NVMe</data>
  <data key="d1">concept</data>
  <data key="d2">Non-Volatile Memory Express (NVMe) is locally attached storage used for high performance use cases.</data>
  <data key="d3">chunk-e3b386253cf68784da43f3bbb4fd519b</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/virtual-machines.md</data>
  <data key="d5">1777003255</data>
  <data key="d6"></data>
