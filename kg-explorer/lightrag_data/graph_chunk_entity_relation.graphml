<node id="Application Insights Profiler">
  <data key="d0">Application Insights Profiler</data>
  <data key="d1">artifact</data>
  <data key="d2">Application Insights Profiler helps optimize hot paths in application code.&lt;SEP&gt;Application Insights Profiler helps identify hot paths and optimize memory allocations and usage.</data>
  <data key="d3">chunk-4c2638addf4f5d994287e1c06820ce5a&lt;SEP&gt;chunk-e16aecaf278f5a9e57cc05404dd1ae26</data>
