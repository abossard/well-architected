</node>
<node id="Prepaid Costs">
  <data key="d0">Prepaid Costs</data>
  <data key="d1">concept</data>
  <data key="d2">Prepaid costs are expenses paid in advance and amortized over a specific period of time.</data>
  <data key="d3">chunk-c54ab6df34391dde2f99128ba16bd1f8</data>
