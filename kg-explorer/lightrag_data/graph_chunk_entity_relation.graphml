  <data key="d0">Azure Network Watcher</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Network Watcher provides packet capture capabilities limited to a maximum period of five hours.&lt;SEP&gt;Azure Network Watcher provides connection monitor and troubleshoot capabilities for validating network connectivity scenarios.</data>
  <data key="d3">chunk-9406ed2aa903d9c51a1e6e1d68aee2dc&lt;SEP&gt;chunk-12a80a8926c38685348cb6badf1d2485</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-security.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/reliability/failure-mode-analysis.md</data>
  <data key="d5">1776981043</data>
  <data key="d6"></data>
</node>
<node id="DDoS Standard Protection Plan">
  <data key="d0">DDoS Standard Protection Plan</data>
  <data key="d1">artifact</data>
  <data key="d2">DDoS standard protection plan secures all public IP addresses within an application.</data>
  <data key="d3">chunk-9406ed2aa903d9c51a1e6e1d68aee2dc</data>
