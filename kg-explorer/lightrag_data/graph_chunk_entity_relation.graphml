  <data key="d5">1776997270</data>
  <data key="d6"></data>
</node>
<node id="In-Place Upgrade">
  <data key="d0">In-Place Upgrade</data>
  <data key="d1">method</data>
  <data key="d2">An in-place upgrade is an upgrade to an existing resource or application that can temporarily slow down or interrupt a workload.</data>
  <data key="d3">chunk-dd9885ad1df3a42bbb9f25a554d6897e</data>
