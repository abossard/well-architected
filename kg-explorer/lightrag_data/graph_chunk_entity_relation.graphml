<node id="Database Index Reorganization">
  <data key="d0">Database Index Reorganization</data>
  <data key="d1">method</data>
  <data key="d2">A maintenance activity that optimizes the current database index.</data>
  <data key="d3">chunk-e4be12a3d391245ffca95ba2ca936932</data>
  <data key="d4">well-architected/performance-efficiency/optimize-operational-tasks.md</data>
