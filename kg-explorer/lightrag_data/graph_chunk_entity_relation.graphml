  <data key="d6"></data>
</node>
<node id="Admin State">
  <data key="d0">Admin State</data>
  <data key="d1">concept</data>
  <data key="d2">Admin State is a Load Balancer feature that allows taking a back-end instance out of rotation without disrupting existing connections during maintenance.</data>
  <data key="d3">chunk-5bac3ac1e7b8113e7254c6008979db0e</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-load-balancer.md</data>
  <data key="d5">1777001950</data>
