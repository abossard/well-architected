  <data key="d6"></data>
</node>
<node id="Managed Virtual Network Isolation">
  <data key="d0">Managed Virtual Network Isolation</data>
  <data key="d1">method</data>
  <data key="d2">A security method that creates a managed virtual network for the workspace, automatically used by managed compute resources to isolate from other networks.</data>
