</node>
<node id="Proprietary Data">
  <data key="d0">Proprietary Data</data>
  <data key="d1">concept</data>
  <data key="d2">Proprietary data is created or owned by the organization, not intended for public consumption, serving internal purposes.</data>
  <data key="d3">chunk-188c7778d5d303d397f8ab1d39a109c6</data>
