  <data key="d0">Load Time</data>
  <data key="d1">concept</data>
  <data key="d2">Load time is the time it takes for an application or web page to be interactive, a response time metric with a common target of 99% of sign-in requests completing in less than 1 second.</data>
  <data key="d3">chunk-2e4e354767f44f79da40710542ed5310</data>
  <data key="d4">well-architected/performance-efficiency/performance-targets.md</data>
  <data key="d5">1776997295</data>
  <data key="d6"></data>
</node>
