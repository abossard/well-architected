  <data key="d1">method</data>
  <data key="d2">Virtual Network encryption protects data in transit between Azure Virtual Machines and Scale Sets within the same or peered virtual networks.</data>
  <data key="d3">chunk-7cd6df2b9534dcc70f59a3fbb6607582</data>
