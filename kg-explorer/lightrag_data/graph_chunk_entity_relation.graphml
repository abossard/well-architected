  <data key="d0">Screen Capture Protection</data>
  <data key="d1">method</data>
  <data key="d2">Screen capture protection blocks or hides remote content in screenshots and screen sharing to prevent sensitive information capture.</data>
  <data key="d3">chunk-13f0ffcfda5392d2501f62dadf04b020</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-virtual-desktop/security.md</data>
