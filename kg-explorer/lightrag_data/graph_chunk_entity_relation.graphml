  <data key="d5">1777003251</data>
  <data key="d6"></data>
</node>
<node id="Network Controller">
  <data key="d0">Network Controller</data>
  <data key="d1">artifact</data>
  <data key="d2">Network Controller provides software-defined networking features and capabilities for filtering and managing network traffic.</data>
  <data key="d3">chunk-51f672aba79072f4ab0bff7c6abfa52d</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-local.md</data>
