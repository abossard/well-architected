  <data key="d0">Security Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Security targets analyze security needs based on data sensitivity and user activities, ensuring compliance with regulatory standards.</data>
  <data key="d3">chunk-ef06ef7197a8a530ba87de793b6cb9e5</data>
  <data key="d4">well-architected/design-guides/optimize-workload-using-flows.md</data>
  <data key="d5">1776999433</data>
  <data key="d6"></data>
</node>
<node id="Cost Targets">
  <data key="d0">Cost Targets</data>
  <data key="d1">concept</data>
  <data key="d2">Cost targets balance cost with performance and ensure resource usage aligns with business priorities.</data>
