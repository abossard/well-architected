  <data key="d0">Level 4 System Hardening</data>
  <data key="d1">concept</data>
  <data key="d2">A security maturity level focused on refining security controls based on production insights and operational data through continuous improvement.</data>
  <data key="d3">chunk-9514c481f519092f6d4362611c52ecde</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996520</data>
  <data key="d6"></data>
</node>
<node id="Key Management Service">
  <data key="d0">Key Management Service</data>
  <data key="d1">concept</data>
  <data key="d2">A service used to manage encryption keys, mitigating the risk of losing keys or failing to rotate them according to requirements.</data>
  <data key="d3">chunk-9514c481f519092f6d4362611c52ecde</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996520</data>
