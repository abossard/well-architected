  <data key="d0">Azure Monitor OpenTelemetry</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Monitor OpenTelemetry enables application monitoring for .NET, Node.js, Python, and Java applications.</data>
  <data key="d3">chunk-13f0658c649d90ef8a4eeed7a17c5339</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/application-insights.md</data>
