  <data key="d5">1777002860</data>
  <data key="d6"></data>
</node>
<node id="Real User Measurements">
  <data key="d0">Real User Measurements</data>
  <data key="d1">method</data>
  <data key="d2">A Traffic Manager feature that views network latency measurements to Azure regions at no extra cost.</data>
