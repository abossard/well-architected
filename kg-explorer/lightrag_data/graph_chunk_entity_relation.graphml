  <data key="d6"></data>
</node>
<node id="Dead Letter">
  <data key="d0">Dead Letter</data>
  <data key="d1">concept</data>
  <data key="d2">Dead letter destinations store events that cannot be delivered, used as a reliability mechanism in Event Grid.</data>
  <data key="d3">chunk-51fbb63c4dcd456a78e4886b5f325302</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-grid.md</data>
  <data key="d5">1777001163</data>
  <data key="d6"></data>
</node>
<node id="Microsoft-Initiated Failover">
  <data key="d0">Microsoft-Initiated Failover</data>
  <data key="d1">method</data>
  <data key="d2">Microsoft-initiated failover automatically replicates Event Grid metadata to paired regions during outages using cross-geo data residency settings.</data>
  <data key="d3">chunk-4d0ea951af59993c2b22cf6dbc254d79</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-grid.md</data>
  <data key="d5">1777001164</data>
  <data key="d6"></data>
</node>
<node id="Customer-Initiated Failover">
  <data key="d0">Customer-Initiated Failover</data>
  <data key="d1">method</data>
  <data key="d2">Customer-initiated failover uses client-side disaster recovery patterns providing full control over secondary region selection and failover timing.</data>
  <data key="d3">chunk-4d0ea951af59993c2b22cf6dbc254d79</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-grid.md</data>
  <data key="d5">1777001164</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Security Devops Extension">
  <data key="d0">Microsoft Security Devops Extension</data>
  <data key="d1">artifact</data>
  <data key="d2">The Microsoft Security DevOps extension scans Bicep or ARM templates to detect common IaC security problems before deployment.</data>
  <data key="d3">chunk-9d6421530c72d2fa97eac8e07332f7bf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-hubs.md</data>
  <data key="d5">1777001266</data>
  <data key="d6"></data>
</node>
<node id="Event Hubs Capture">
  <data key="d0">Event Hubs Capture</data>
  <data key="d1">artifact</data>
  <data key="d2">Event Hubs Capture enables long-term storage of event data to Azure Blob Storage or Azure Data Lake Store.&lt;SEP&gt;Event Hubs Capture is a feature for capturing event data with associated operation and destination storage costs.</data>
  <data key="d3">chunk-9d6421530c72d2fa97eac8e07332f7bf&lt;SEP&gt;chunk-1bb68bab7c1b474f207b34f9a74328e7</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-hubs.md</data>
  <data key="d5">1777001267</data>
  <data key="d6"></data>
</node>
<node id="RequestsAuthenticationError">
  <data key="d0">RequestsAuthenticationError</data>
  <data key="d1">data</data>
  <data key="d2">RequestsAuthenticationError is a metric used to create alerts for detecting authentication attacks, with a recommended threshold of more than 10 per hour.</data>
  <data key="d3">chunk-9d6421530c72d2fa97eac8e07332f7bf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-hubs.md</data>
  <data key="d5">1777001267</data>
  <data key="d6"></data>
</node>
<node id="Azure Stream Analytics">
  <data key="d0">Azure Stream Analytics</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Stream Analytics is a downstream processing service that consumes events from Event Hubs.</data>
  <data key="d3">chunk-bd9ecc5b1e909344bcefaee765852bdf</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-event-hubs.md</data>
  <data key="d5">1777001276</data>
  <data key="d6"></data>
</node>
<node id="Schema Registry">
  <data key="d0">Schema Registry</data>
  <data key="d1">artifact</data>
  <data key="d2">Schema registry is used to test schema evolution compatibility in Event Hubs streaming workloads.&lt;SEP&gt;Schema Registry is a functionality integrated with Azure Event Hubs to enhance serialization efficiency.&lt;SEP&gt;Schema Registry integrates with Event Hubs for compression and data management.</data>
  <data key="d3">chunk-bd9ecc5b1e909344bcefaee765852bdf&lt;SEP&gt;chunk-db510f47656045373bcac562ba7e53ca&lt;SEP&gt;chunk-9477f91dc0a48476ae389364456c73e9</data>
