  <data key="d6"></data>
</node>
<node id="Live-Site Support">
  <data key="d0">Live-Site Support</data>
  <data key="d1">concept</data>
  <data key="d2">Live-site support involves real-time monitoring and responding to incidents affecting system availability, security, performance, or deployment.</data>
  <data key="d3">chunk-b111334644545025473a63cd0bd3a289</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/incident-management.md</data>
  <data key="d5">1777004535</data>
  <data key="d6"></data>
</node>
<node id="On-Call Function">
  <data key="d0">On-Call Function</data>
  <data key="d1">concept</data>
  <data key="d2">An on-call function where engineers handle complex cases, investigate incidents, and take action, with rotating responsibilities.</data>
  <data key="d3">chunk-b111334644545025473a63cd0bd3a289</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/incident-management.md</data>
  <data key="d5">1777004535</data>
  <data key="d6"></data>
</node>
