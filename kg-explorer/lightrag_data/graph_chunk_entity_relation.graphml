  <data key="d6"></data>
</node>
<node id="Edge Computing">
  <data key="d0">Edge Computing</data>
  <data key="d1">concept</data>
  <data key="d2">Edge computing involves moving data processing, ingestion, computation, and storage to the edge, enabling real-time data processing with reduced latency and energy consumption.</data>
  <data key="d3">chunk-5c9960b8b9c51b110df1728d769e8cad</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
