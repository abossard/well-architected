  <data key="d5">1777001864</data>
  <data key="d6"></data>
</node>
<node id="Network Policy">
  <data key="d0">Network Policy</data>
  <data key="d1">concept</data>
  <data key="d2">Network Policy is a Kubernetes feature used to define ingress and egress traffic rules between pods in a cluster.&lt;SEP&gt;Network Policy is a Kubernetes feature used to define ingress and egress traffic rules between pods in a cluster.</data>
  <data key="d3">chunk-f5321cfe4fbc08d735ac5eac02e84e4d</data>
