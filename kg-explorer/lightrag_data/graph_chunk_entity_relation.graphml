</node>
<node id="Ingress Traffic">
  <data key="d0">Ingress Traffic</data>
  <data key="d1">concept</data>
  <data key="d2">Ingress traffic is incoming network traffic that needs inspection for security threats.</data>
  <data key="d3">chunk-84edc61960c2c1e2ea0cf79280a5461f</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/networking.md</data>
