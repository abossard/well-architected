  <data key="d0">Sample-Based Profiling</data>
  <data key="d1">method</data>
  <data key="d2">Sample-based profiling collects data at intervals based on time or frequency, reducing overhead for frequent events.</data>
  <data key="d3">chunk-7404990d0db645a738f8e03698df0941</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
  <data key="d5">1776997955</data>
  <data key="d6"></data>
</node>
