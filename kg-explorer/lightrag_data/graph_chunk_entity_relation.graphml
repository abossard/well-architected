  <data key="d0">Shift Right Testing</data>
  <data key="d1">method</data>
  <data key="d2">Shift right testing involves testing in production using strategies like blue-green deployments and A/B testing.</data>
  <data key="d3">chunk-f4d7f07b48cc1c474bedf5d938c8ae09</data>
