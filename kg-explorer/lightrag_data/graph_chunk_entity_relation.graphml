  <data key="d6"></data>
</node>
<node id="MLOps">
  <data key="d0">MLOps</data>
  <data key="d1">concept</data>
  <data key="d2">MLOps applies DevOps practices to automate the ML lifecycle for training, operationalization, scoring, and continuous improvement.</data>
  <data key="d3">chunk-8a6891eb227254197568b44bf03596d7</data>
