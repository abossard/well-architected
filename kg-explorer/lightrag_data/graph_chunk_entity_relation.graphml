</node>
<node id="Resource Identity">
  <data key="d0">Resource Identity</data>
  <data key="d1">concept</data>
  <data key="d2">Resource identity provides components like containers access to deployment pipelines for configuration.</data>
  <data key="d3">chunk-3ea57e7a575650ba4d31b8ba51cf8991</data>
  <data key="d4">well-architected/security/identity-access.md</data>
  <data key="d5">1776996407</data>
