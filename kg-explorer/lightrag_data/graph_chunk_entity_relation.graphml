  <data key="d5">1777004054</data>
  <data key="d6"></data>
</node>
<node id="Validation Data">
  <data key="d0">Validation Data</data>
  <data key="d1">concept</data>
  <data key="d2">Validation data is used to monitor and validate machine learning model performance during training, distinct from training and test data, and guides hyperparameter tuning.</data>
  <data key="d3">chunk-188c7778d5d303d397f8ab1d39a109c6</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/training-data-design.md</data>
  <data key="d5">1777004055</data>
  <data key="d6"></data>
</node>
<node id="Testing Data">
  <data key="d0">Testing Data</data>
  <data key="d1">concept</data>
  <data key="d2">Testing data validates the predictive power of a trained model using data sampled from source data not used for training.&lt;SEP&gt;Testing data is used to validate the predictive power of a trained model, sampled from source data not used for training.</data>
  <data key="d3">chunk-188c7778d5d303d397f8ab1d39a109c6&lt;SEP&gt;chunk-d88dee01d0a30636bf4119d50523dfef</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/training-data-design.md</data>
  <data key="d5">1777004055</data>
  <data key="d6"></data>
</node>
<node id="Multi-Modal Data">
  <data key="d0">Multi-Modal Data</data>
  <data key="d1">concept</data>
  <data key="d2">Multi-modal data combines different data types like text, images, audio, or video within the same training dataset.</data>
  <data key="d3">chunk-188c7778d5d303d397f8ab1d39a109c6</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/training-data-design.md</data>
