</node>
<node id="Azure VM Insights">
  <data key="d0">Azure VM Insights</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure VM Insights provides specialized monitoring for virtual machine workloads with performance maps and dependency tracking.</data>
  <data key="d3">chunk-076af166b0a5d9e2082c3e0f5ea9ed65</data>
