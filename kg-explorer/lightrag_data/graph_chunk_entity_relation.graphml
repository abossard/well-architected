  <data key="d5">1777000324</data>
  <data key="d6"></data>
</node>
<node id="Azure Monitor Alerts">
  <data key="d0">Azure Monitor Alerts</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Monitor Alerts enables intelligent alerting with action groups, notification routing, and automated responses.</data>
  <data key="d3">chunk-076af166b0a5d9e2082c3e0f5ea9ed65</data>
  <data key="d4">well-architected/design-guides/monitoring.md</data>
  <data key="d5">1776999384</data>
