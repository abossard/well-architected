</node>
<node id="AKS Security Baseline">
  <data key="d0">AKS Security Baseline</data>
  <data key="d1">content</data>
  <data key="d2">AKS security baseline provides configuration guidance for ensuring a suitable security posture for mission-critical AKS scenarios.</data>
  <data key="d3">chunk-1c97b53f9c2bcaf2eaf8ee6eff46b6b2</data>
