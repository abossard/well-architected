<node id="Ingestion-Time Transformation">
  <data key="d0">Ingestion-Time Transformation</data>
  <data key="d1">method</data>
  <data key="d2">Ingestion-time transformation is a method to selectively process and store relevant log data to optimize log analytics costs.</data>
