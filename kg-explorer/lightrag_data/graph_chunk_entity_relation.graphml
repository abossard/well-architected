<node id="OWASP Dependency-Check">
  <data key="d0">OWASP Dependency-Check</data>
  <data key="d1">artifact</data>
  <data key="d2">OWASP Dependency-Check is a free tool for identifying known vulnerabilities in project dependencies.</data>
