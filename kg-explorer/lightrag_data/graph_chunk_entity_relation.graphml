  <data key="d5">1776979833</data>
  <data key="d6"></data>
</node>
<node id="NServiceBus">
  <data key="d0">NServiceBus</data>
  <data key="d1">artifact</data>
  <data key="d2">A messaging framework with built-in resiliency features.&lt;SEP&gt;NServiceBus is a library that provides functionality for adding critical time information to message headers for autoscaling decisions.&lt;SEP&gt;NServiceBus is a library that provides checkpoint functionality by transparently persisting state aligned with message processing.</data>
  <data key="d3">chunk-36d66c785cc9b10b4cf377888b6bd59f&lt;SEP&gt;chunk-c387aff770332292e0a1e78af18b8fbe&lt;SEP&gt;chunk-3df6e00fa9a90ca53e8d360c865875b4</data>
