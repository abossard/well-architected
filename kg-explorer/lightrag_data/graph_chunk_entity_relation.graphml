<node id="Role-Based Access Controls">
  <data key="d0">Role-Based Access Controls</data>
  <data key="d1">method</data>
  <data key="d2">A method to limit access to workload components by applying granular permissions based on user roles.</data>
  <data key="d3">chunk-50e84f8f3385ed4e029dfd1f75a5fc3e</data>
  <data key="d4">well-architected/security/maturity-model.md</data>
  <data key="d5">1776996514</data>
  <data key="d6"></data>
</node>
<node id="Conditional Access Policies">
  <data key="d0">Conditional Access Policies</data>
  <data key="d1">method</data>
  <data key="d2">Policies that grant or deny access based on conditions like geographic location or device compliance.&lt;SEP&gt;Conditional Access policies enforce MFA, device compliance, and location restrictions for Azure VPN connections.</data>
  <data key="d3">chunk-50e84f8f3385ed4e029dfd1f75a5fc3e&lt;SEP&gt;chunk-22d333e97696a760da77cbcd035a0d29</data>
