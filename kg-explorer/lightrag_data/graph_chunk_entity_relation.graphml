<node id="Data Store">
  <data key="d0">Data Store</data>
  <data key="d1">concept</data>
  <data key="d2">A data store is a resource that stores data such as a database, object store, or file share.</data>
  <data key="d3">chunk-dcd9326bd28e1ca67beb40e575a0abd3</data>
  <data key="d4">well-architected/performance-efficiency/optimize-data-performance.md</data>
  <data key="d5">1776997230</data>
  <data key="d6"></data>
</node>
<node id="Database Index">
  <data key="d0">Database Index</data>
  <data key="d1">concept</data>
  <data key="d2">A database index is a structure that provides quick access to items in a database, requiring periodic rebuilding or reorganization for maintenance.</data>
  <data key="d3">chunk-dcd9326bd28e1ca67beb40e575a0abd3</data>
  <data key="d4">well-architected/performance-efficiency/optimize-data-performance.md</data>
