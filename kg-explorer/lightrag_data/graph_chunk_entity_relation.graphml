<node id="Data Poisoning">
  <data key="d0">Data Poisoning</data>
  <data key="d1">concept</data>
  <data key="d2">Data poisoning is a security risk involving insertion of malicious vectors into embedding stores.</data>
  <data key="d3">chunk-c0582c7a093b3909eeea812b8cd03ce7</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/data-platform.md</data>
  <data key="d5">1777003558</data>
  <data key="d6"></data>
</node>
<node id="Batch Inference Data Store">
  <data key="d0">Batch Inference Data Store</data>
  <data key="d1">concept</data>
  <data key="d2">A batch inference data store pre-computes inference results and stores them for later use, reducing latency, improving scalability, and lowering compute costs.&lt;SEP&gt;A batch inference data store is a storage layer used in some ML workloads for batch processing of model predictions.</data>
  <data key="d3">chunk-c0582c7a093b3909eeea812b8cd03ce7&lt;SEP&gt;chunk-88acce1b2be2296ca1e97b9e9e3c8cad</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/data-platform.md</data>
  <data key="d5">1777003559</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Fabric Data Science">
  <data key="d0">Microsoft Fabric Data Science</data>
  <data key="d1">organization</data>
  <data key="d2">Microsoft Fabric Data Science is a platform used in RAG workflows.</data>
  <data key="d3">chunk-c1615f9ff2ca4b3875210de37b97549d</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/ai/data-platform.md</data>
  <data key="d5">1777003560</data>
  <data key="d6"></data>
