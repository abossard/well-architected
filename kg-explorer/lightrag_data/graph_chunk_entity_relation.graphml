  <data key="d0">Ampere Altra Arm-Based Processors</data>
  <data key="d1">artifact</data>
  <data key="d2">Ampere Altra Arm-based processors are cost-effective and power-efficient processors available for Azure Virtual Machines.</data>
  <data key="d3">chunk-e0c191d35e97adae9dac9c5492df49a2</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainability-application-platform.md</data>
  <data key="d5">1777005541</data>
  <data key="d6"></data>
</node>
<node id="Azure App Service Environment">
  <data key="d0">Azure App Service Environment</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure App Service Environment (ASE) is a provisioned service that may lead to unused compute resources compared to an App Service plan.</data>
