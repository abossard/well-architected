  <data key="d0">Cosmos DB Query Advisor</data>
  <data key="d1">artifact</data>
  <data key="d2">Cosmos DB Query Advisor provides recommendations for optimizing query performance, indexing strategies, and resource utilization.</data>
  <data key="d3">chunk-3a99a5a991c44794d4415bc58af98647</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/cosmos-db.md</data>
  <data key="d5">1777003082</data>
  <data key="d6"></data>
</node>
