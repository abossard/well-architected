<node id="Security Readiness Plan">
  <data key="d0">Security Readiness Plan</data>
  <data key="d1">concept</data>
  <data key="d2">A security readiness plan is aligned with business priorities and provides well-defined processes, adequate investments, and appropriate accountabilities for protecting assets.&lt;SEP&gt;A security readiness plan is aligned with business priorities and provides well-defined processes, adequate investments, and appropriate accountabilities for protecting assets.</data>
  <data key="d3">chunk-77f391cc5c3fa628d6f44144e1bef0b4</data>
