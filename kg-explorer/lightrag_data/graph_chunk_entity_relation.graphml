  <data key="d6"></data>
</node>
<node id="Unified Data Sink">
  <data key="d0">Unified Data Sink</data>
  <data key="d1">concept</data>
  <data key="d2">A unified data sink stores all operational data for correlated analysis to build a single pane representation of application health.</data>
