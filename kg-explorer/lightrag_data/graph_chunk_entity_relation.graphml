  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
  <data key="d5">1776979595</data>
  <data key="d6"></data>
</node>
<node id="Single Server">
  <data key="d0">Single Server</data>
  <data key="d1">artifact</data>
  <data key="d2">Single Server is a deployment option for Azure Database for PostgreSQL with SLA 99.99%.</data>
  <data key="d3">chunk-65d6d67b4e65531ad950d1206265e623</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
  <data key="d5">1776979595</data>
  <data key="d6"></data>
</node>
<node id="Active Geo-Replication">
  <data key="d0">Active Geo-Replication</data>
  <data key="d1">method</data>
  <data key="d2">Active Geo-Replication deploys readable replicas within all deployment regions, up to four.</data>
  <data key="d3">chunk-65d6d67b4e65531ad950d1206265e623</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
  <data key="d5">1776979595</data>
