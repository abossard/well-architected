  <data key="d0">Deployment Slot</data>
  <data key="d1">concept</data>
  <data key="d2">A feature of Azure App Service enabling deployment of live apps with their own host names.</data>
  <data key="d3">chunk-e4be12a3d391245ffca95ba2ca936932</data>
  <data key="d4">well-architected/performance-efficiency/optimize-operational-tasks.md</data>
  <data key="d5">1776997269</data>
  <data key="d6"></data>
</node>
<node id="Database Index Rebuilding">
  <data key="d0">Database Index Rebuilding</data>
  <data key="d1">method</data>
  <data key="d2">A maintenance activity that drops and recreates a database index.</data>
  <data key="d3">chunk-e4be12a3d391245ffca95ba2ca936932</data>
  <data key="d4">well-architected/performance-efficiency/optimize-operational-tasks.md</data>
  <data key="d5">1776997269</data>
