  <data key="d5">1776999381</data>
  <data key="d6"></data>
</node>
<node id="Traces">
  <data key="d0">Traces</data>
  <data key="d1">concept</data>
  <data key="d2">Traces are monitoring signals used to provide context for flows and dependencies.&lt;SEP&gt;Data that provides information about the path a request travels through services and components.&lt;SEP&gt;Records showing the path of requests through distributed systems, helping diagnose issues spanning multiple services.&lt;SEP&gt;Traces are monitoring signals used to provide context for flows and dependencies.&lt;SEP&gt;Records that track request paths across components, showing how a request flows through distributed systems.</data>
  <data key="d3">chunk-5ea3d1c60d4f024bf104694fc558f794&lt;SEP&gt;chunk-a9b99a62e53e59edcc42c5c691f68045&lt;SEP&gt;chunk-44db748d8a4a0feea6626c78c05321a2&lt;SEP&gt;chunk-564e02afbba673b81e1950dcf16d845f</data>
