  <data key="d6"></data>
</node>
<node id="EDA">
  <data key="d0">EDA</data>
  <data key="d1">method</data>
  <data key="d2">Exploratory Data Analysis (EDA) helps analyze source data to identify characteristics, relationships, patterns, and quality issues early during feature design.</data>
