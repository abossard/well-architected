  <data key="d0">VMware SRM</data>
  <data key="d1">artifact</data>
  <data key="d2">VMware SRM is an optional site recovery component of the VMware SDDC stack.</data>
  <data key="d3">chunk-d2316cc990e8eb48dc944c11d4a38990</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/infrastructure.md</data>
  <data key="d5">1777005235</data>
