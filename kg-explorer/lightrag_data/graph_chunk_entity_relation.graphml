<node id="Azure Data Lake Gen2">
  <data key="d0">Azure Data Lake Gen2</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Data Lake Gen2 is a supported store for Synapse with hierarchical namespace capabilities.</data>
