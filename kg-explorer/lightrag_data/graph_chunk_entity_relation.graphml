  <data key="d0">External Dependencies</data>
  <data key="d1">concept</data>
  <data key="d2">Elements outside the primary workload such as integrated third-party services or tools that can significantly affect performance.</data>
  <data key="d3">chunk-2e4e354767f44f79da40710542ed5310</data>
  <data key="d4">well-architected/performance-efficiency/performance-targets.md</data>
  <data key="d5">1776997295</data>
