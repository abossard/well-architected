  <data key="d5">1777002546</data>
  <data key="d6"></data>
</node>
<node id="Transient Fault Handling">
  <data key="d0">Transient Fault Handling</data>
  <data key="d1">concept</data>
  <data key="d2">A mechanism designed to detect and handle transient faults in applications by implementing retry logic and appropriate strategies.</data>
  <data key="d3">chunk-b3207502b3998d10c15635a0423fbe72</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999213</data>
  <data key="d6"></data>
</node>
<node id="Incremental Intervals">
  <data key="d0">Incremental Intervals</data>
  <data key="d1">method</data>
  <data key="d2">A retry strategy where the delay between retries increases incrementally.</data>
  <data key="d3">chunk-b3207502b3998d10c15635a0423fbe72</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999213</data>
  <data key="d6"></data>
</node>
<node id="Regular Intervals">
  <data key="d0">Regular Intervals</data>
  <data key="d1">method</data>
  <data key="d2">A retry strategy using the same fixed time period between each retry attempt.</data>
  <data key="d3">chunk-b3207502b3998d10c15635a0423fbe72</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999213</data>
  <data key="d6"></data>
</node>
<node id="Immediate Retry">
  <data key="d0">Immediate Retry</data>
  <data key="d1">method</data>
  <data key="d2">A retry strategy that retries the operation immediately after a brief transient fault, limited to one attempt before switching strategies.</data>
  <data key="d3">chunk-b3207502b3998d10c15635a0423fbe72</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999213</data>
  <data key="d6"></data>
</node>
<node id="IsTransient">
  <data key="d0">IsTransient</data>
  <data key="d1">data</data>
  <data key="d2">A value returned by services to indicate whether a fault is transient and the client should retry the operation.</data>
  <data key="d3">chunk-b3207502b3998d10c15635a0423fbe72</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
  <data key="d5">1776999214</data>
  <data key="d6"></data>
</node>
<node id="Entity Framework Core">
  <data key="d0">Entity Framework Core</data>
  <data key="d1">artifact</data>
  <data key="d2">Entity Framework Core is an ORM with native retry support and connection resiliency features.</data>
  <data key="d3">chunk-6fbfe826fe19c233eb2d1b279f7950e7</data>
  <data key="d4">well-architected/design-guides/handle-transient-faults.md</data>
