  <data key="d0">TimescaleDB</data>
  <data key="d1">artifact</data>
  <data key="d2">A PostgreSQL extension feature supported by Azure Database for PostgreSQL.</data>
  <data key="d3">chunk-e85737e4794e90bbd715857ab9acd5bf</data>
