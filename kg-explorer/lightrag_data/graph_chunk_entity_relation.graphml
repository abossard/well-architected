  <data key="d0">Azure Blob Storage</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Blob Storage is a storage service that Azure Synapse can register external datasets from.</data>
  <data key="d3">chunk-4678f659d2199619f053d40287ff2e4a</data>
