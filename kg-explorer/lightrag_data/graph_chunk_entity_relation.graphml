<node id="Thin Provisioning">
  <data key="d0">Thin Provisioning</data>
  <data key="d1">method</data>
  <data key="d2">Thin provisioning allocates storage on demand, optimizing storage usage by minimizing unused space.</data>
  <data key="d3">chunk-d2316cc990e8eb48dc944c11d4a38990</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/infrastructure.md</data>
  <data key="d5">1777005235</data>
  <data key="d6"></data>
</node>
<node id="Thick Provisioning">
  <data key="d0">Thick Provisioning</data>
  <data key="d1">method</data>
  <data key="d2">Thick provisioning reserves the full amount of storage space from the start for each VM.</data>
  <data key="d3">chunk-d2316cc990e8eb48dc944c11d4a38990</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/infrastructure.md</data>
