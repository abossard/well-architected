  <data key="d5">1777003961</data>
  <data key="d6"></data>
</node>
<node id="Model Routing">
  <data key="d0">Model Routing</data>
  <data key="d1">method</data>
  <data key="d2">Model routing involves directing straightforward requests to smaller lower-cost models and reserving advanced models for complex tasks.</data>
  <data key="d3">chunk-3a81a26ddd3f3a3848c76ca543d5b996</data>
  <data key="d4">well-architected/operational-excellence/maturity-model.md</data>
  <data key="d5">1776997905</data>
  <data key="d6"></data>
</node>
<node id="Least-Privilege Principles">
  <data key="d0">Least-Privilege Principles</data>
  <data key="d1">concept</data>
  <data key="d2">Least-privilege principles limit tool execution permissions and scope for AI agents to prevent unauthorized modifications.</data>
  <data key="d3">chunk-3a81a26ddd3f3a3848c76ca543d5b996</data>
  <data key="d4">well-architected/operational-excellence/maturity-model.md</data>
  <data key="d5">1776997905</data>
  <data key="d6"></data>
</node>
<node id="Full Profiling">
  <data key="d0">Full Profiling</data>
  <data key="d1">method</data>
  <data key="d2">Full profiling is a runtime data collection approach that is more precise but adds significant overhead and can slow down the system.</data>
  <data key="d3">chunk-7404990d0db645a738f8e03698df0941</data>
  <data key="d4">well-architected/operational-excellence/observability.md</data>
