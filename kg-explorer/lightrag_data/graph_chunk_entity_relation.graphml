<node id="Taxonomy">
  <data key="d0">Taxonomy</data>
  <data key="d1">concept</data>
  <data key="d2">Taxonomy is a hierarchical system to organize classified data using an agreed upon structure with named entities indicating categorization criteria.</data>
  <data key="d3">chunk-8bfa9de462a82f93657efb2d63f7e3fe</data>
  <data key="d4">well-architected/security/data-classification.md</data>
