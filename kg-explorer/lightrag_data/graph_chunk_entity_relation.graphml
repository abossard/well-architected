</node>
<node id="Reliability Costs">
  <data key="d0">Reliability Costs</data>
  <data key="d1">concept</data>
  <data key="d2">Reliability costs include resiliency costs for staying online and recoverability costs for getting back online after a disruption.</data>
  <data key="d3">chunk-1f082730bb91f06b04e3b6f39138f774</data>
  <data key="d4">well-architected/cost-optimization/cost-model.md</data>
  <data key="d5">1776998339</data>
