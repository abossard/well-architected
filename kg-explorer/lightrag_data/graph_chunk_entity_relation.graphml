  <data key="d5">1777005046</data>
  <data key="d6"></data>
</node>
<node id="ECasv5">
  <data key="d0">ECasv5</data>
  <data key="d1">artifact</data>
  <data key="d2">ECasv5 is a confidential VM size providing robust high-security features.&lt;SEP&gt;ECasv5 is an Azure VM series recommended for high-security workloads with no local disk.&lt;SEP&gt;ECasv5 is an Azure confidential VM series providing hardware-based TEE with AMD SEV-SNP security capabilities.</data>
  <data key="d3">chunk-7edb1f343516427f2303f45fae771d0c&lt;SEP&gt;chunk-8e6a367b5313dacf4139b0da89a311c1&lt;SEP&gt;chunk-5dace10a501d3c2b544e137b224cd683</data>
