  <data key="d5">1776998132</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Entra Privileged Identity Management">
  <data key="d0">Microsoft Entra Privileged Identity Management</data>
  <data key="d1">artifact</data>
  <data key="d2">A technology used to apply a zero-trust model ensuring operations occur only through CI/CD processes or automated procedures.&lt;SEP&gt;Microsoft Entra PIM revokes sustained control plane access to production environments to reduce risk from malicious admin scenarios.&lt;SEP&gt;Microsoft Entra Privileged Identity Management provides role-based access control for read access to billing data.</data>
  <data key="d3">chunk-a324803e46dec295e5d9abb5a43f8a29&lt;SEP&gt;chunk-b31cf91ba30eab331729c73c4002b505&lt;SEP&gt;chunk-9896bbc28e252b9ce2f3f2bb74ad70f1</data>
