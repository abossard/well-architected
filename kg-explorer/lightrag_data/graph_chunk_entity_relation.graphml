<node id="Stretched Cluster">
  <data key="d0">Stretched Cluster</data>
  <data key="d1">concept</data>
  <data key="d2">A stretched cluster distributes computing resources across fault domains or availability zones for high availability.</data>
  <data key="d3">chunk-bc9c17e8a9e3ca66742a781b355fe68c</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-vmware/infrastructure.md</data>
