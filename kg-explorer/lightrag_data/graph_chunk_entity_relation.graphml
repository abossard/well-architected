<node id="Microsoft Entra External ID">
  <data key="d0">Microsoft Entra External ID</data>
  <data key="d1">artifact</data>
  <data key="d2">Microsoft Entra External ID handles identity for partners.&lt;SEP&gt;Microsoft Entra External ID is an identity provider for screening gateway requests and protecting backend APIs.</data>
  <data key="d3">chunk-385f36a776384c86dd2e520eb0f51b04&lt;SEP&gt;chunk-1c7409b2f79632903a9d9de4c67055d6</data>
