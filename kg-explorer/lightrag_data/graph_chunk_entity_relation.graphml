<node id="Business-Critical Service Tier">
  <data key="d0">Business-Critical Service Tier</data>
  <data key="d1">concept</data>
  <data key="d2">The Business-Critical service tier maximizes reliability and availability for Azure SQL Database, including critical resiliency capabilities.</data>
  <data key="d3">chunk-65d6d67b4e65531ad950d1206265e623</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
