  <data key="d5">1776998072</data>
  <data key="d6"></data>
</node>
<node id="Smoke Tests">
  <data key="d0">Smoke Tests</data>
  <data key="d1">method</data>
  <data key="d2">Smoke tests are run as part of every deployment to validate basic application functionality.&lt;SEP&gt;Fast smoke tests run on every commit as part of the regression testing strategy.</data>
  <data key="d3">chunk-c97a1db66c7ecde12774487f7afb1593&lt;SEP&gt;chunk-c7f1e74a0c11b25222056af287680862</data>
