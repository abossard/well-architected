  <data key="d5">1776983279</data>
  <data key="d6"></data>
</node>
<node id="Azure DDoS Standard">
  <data key="d0">Azure DDoS Standard</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure DDoS Standard provides additional advanced protection and detection capabilities as an added layer to Azure Front Door.&lt;SEP&gt;Azure DDoS Standard provides additional advanced protection and detection capabilities as an added layer to Azure Front Door.</data>
  <data key="d3">chunk-ce015784fd1d8129dac8c9bbf32bf565</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-networking-connectivity.md</data>
