  <data key="d13"></data>
</edge>
<edge source="Performance Efficiency" target="Redundancy">
  <data key="d7">1.0</data>
  <data key="d8">Redundancy for reliability and performance efficiency must work together to avoid overwhelming remaining nodes during failures.</data>
  <data key="d9">load distribution,trade-off</data>
