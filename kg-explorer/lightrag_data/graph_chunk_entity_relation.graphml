  <data key="d5">1776999215</data>
  <data key="d6"></data>
</node>
<node id="Scale Units">
  <data key="d0">Scale Units</data>
  <data key="d1">concept</data>
  <data key="d2">Scale units are logical groupings of components that scale together with defined scale increments.&lt;SEP&gt;Scalable segments of a workload that ensure robust performance under increased loads.</data>
  <data key="d3">chunk-c65b26c693a23d19a5f6c2c2910aca49&lt;SEP&gt;chunk-2e4e354767f44f79da40710542ed5310</data>
