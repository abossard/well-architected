</node>
<node id="Continuous Backup Mode">
  <data key="d0">Continuous Backup Mode</data>
  <data key="d1">method</data>
  <data key="d2">A backup mode allowing point-in-time restore with one-second granularity within the last 30 days, supporting self-service restore.</data>
  <data key="d3">chunk-caad63f908cd3b639ca5d51c5a2341ae</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
  <data key="d5">1776979595</data>
  <data key="d6"></data>
</node>
