<node id="Commitment-Based Billing Model">
  <data key="d0">Commitment-Based Billing Model</data>
  <data key="d1">concept</data>
  <data key="d2">A pricing model where usage is reserved and paid for in advance at a discounted rate compared to consumption pricing.</data>
  <data key="d3">chunk-e259f9d5ef6cf3be37487cfef56d05dc</data>
  <data key="d4">well-architected/cost-optimization/get-best-rates.md</data>
  <data key="d5">1776998450</data>
