  <data key="d5">1777004471</data>
  <data key="d6"></data>
</node>
<node id="Product SKUs">
  <data key="d0">Product SKUs</data>
  <data key="d1">concept</data>
  <data key="d2">Product SKUs represent service tiers in Azure products, with various options within each service.</data>
  <data key="d3">chunk-1fd0de7f853795f167d30d84ede72282</data>
  <data key="d4">well-architected/cost-optimization/align-usage-to-billing-increments.md</data>
