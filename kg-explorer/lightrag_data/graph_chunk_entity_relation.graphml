<node id="Virtual Desktop">
  <data key="d0">Virtual Desktop</data>
  <data key="d1">concept</data>
  <data key="d2">Virtual Desktop is a cloud-based desktop and application virtualization service whose performance depends on storage solutions and fault tolerance configurations.</data>
  <data key="d3">chunk-7edb1f343516427f2303f45fae771d0c</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/azure-virtual-desktop/application-delivery.md</data>
