</node>
<node id="Carbon Neutralization">
  <data key="d0">Carbon Neutralization</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon neutralization involves compensating carbon emissions.</data>
  <data key="d3">chunk-5b8b47369e36bfe734725b284a7694f4</data>
