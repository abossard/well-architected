  <data key="d5">1776981629</data>
  <data key="d6"></data>
</node>
<node id="Event Hubs">
  <data key="d0">Event Hubs</data>
  <data key="d1">artifact</data>
  <data key="d2">Event Hubs is a messaging service whose incoming/outgoing messages are key operational metrics.&lt;SEP&gt;Event Hubs is an Azure messaging service monitored for incoming/outgoing messages.</data>
  <data key="d3">chunk-09511819f8c1ba5a16e71983efd9f8b7&lt;SEP&gt;chunk-a26205fb34c4e32a46218f4e0a88ca82</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-health-modeling.md</data>
  <data key="d5">1776979824</data>
  <data key="d6"></data>
</node>
<node id="Azure Data Explorer">
  <data key="d0">Azure Data Explorer</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Data Explorer is the technology that Log Analytics workspaces are based on for log storage.&lt;SEP&gt;Azure Data Explorer uses Kusto Query Language (KQL) along with Log Analytics and Application Insights.&lt;SEP&gt;Azure Data Explorer is an alternative to Log Analytics for executing queries to calculate health scores.</data>
  <data key="d3">chunk-09511819f8c1ba5a16e71983efd9f8b7&lt;SEP&gt;chunk-7255c274585b0f1f482e338bbc6c26aa&lt;SEP&gt;chunk-1bc4a6aa7dad91160ab49f8c99c2ea47</data>
