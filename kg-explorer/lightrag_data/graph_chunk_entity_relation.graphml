  <data key="d6"></data>
</node>
<node id="IPsec">
  <data key="d0">IPsec</data>
  <data key="d1">concept</data>
  <data key="d2">Internet Protocol Security (IPsec) is used with IKE encryption policies for site-to-site VPN between Azure and on-premises devices.</data>
  <data key="d3">chunk-de21122336bd114f1583106e238ec656</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-virtual-wan.md</data>
