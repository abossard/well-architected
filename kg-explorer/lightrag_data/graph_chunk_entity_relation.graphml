  <data key="d5">1777006102</data>
  <data key="d6"></data>
</node>
<node id="HPC Workloads">
  <data key="d0">HPC Workloads</data>
  <data key="d1">concept</data>
  <data key="d2">High-performance computing workloads are computational tasks requiring significantly more processing power, memory, and I/O throughput than typical systems, designed for compute-intensive operations using parallel processing.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006103</data>
  <data key="d6"></data>
</node>
<node id="Slurm">
  <data key="d0">Slurm</data>
  <data key="d1">artifact</data>
  <data key="d2">Slurm is a workload manager used in HPC environments for scheduling and managing jobs.&lt;SEP&gt;Slurm is a job scheduler supported natively by Azure CycleCloud for HPC workload submission.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866&lt;SEP&gt;chunk-1fb59ec0b1695072206ffa411ddbbf16</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-principles.md</data>
  <data key="d5">1777006204</data>
  <data key="d6"></data>
</node>
<node id="PBS">
  <data key="d0">PBS</data>
  <data key="d1">artifact</data>
  <data key="d2">PBS is a workload manager used in HPC environments.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006104</data>
  <data key="d6"></data>
</node>
<node id="LSF">
  <data key="d0">LSF</data>
  <data key="d1">artifact</data>
  <data key="d2">LSF is a workload manager used in HPC environments.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006104</data>
  <data key="d6"></data>
</node>
<node id="InfiniBand">
  <data key="d0">InfiniBand</data>
  <data key="d1">concept</data>
  <data key="d2">InfiniBand is a low-latency networking technology used in HPC environments.&lt;SEP&gt;InfiniBand is a high-speed networking technology used for low-latency inter-node communication in HPC environments.&lt;SEP&gt;InfiniBand is a high-bandwidth, low-latency networking technology used for MPI workloads requiring efficient node-to-node communication.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866&lt;SEP&gt;chunk-1c64e72596f12ff7c458fd34e5a4d481&lt;SEP&gt;chunk-4b14a078d2121adef2ae56cc9aaead82</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-principles.md</data>
  <data key="d5">1777006205</data>
  <data key="d6"></data>
</node>
<node id="RoCE">
  <data key="d0">RoCE</data>
  <data key="d1">artifact</data>
  <data key="d2">RoCE is a low-latency networking technology used in HPC environments.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006104</data>
  <data key="d6"></data>
</node>
<node id="MPI">
  <data key="d0">MPI</data>
  <data key="d1">concept</data>
  <data key="d2">MPI (Message Passing Interface) is a parallel programming method used in HPC workloads.&lt;SEP&gt;MPI (Message Passing Interface) is a communication protocol for parallel computing that is sensitive to cluster topology and latency.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866&lt;SEP&gt;chunk-4b14a078d2121adef2ae56cc9aaead82</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md&lt;SEP&gt;/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-design-principles.md</data>
  <data key="d5">1777006205</data>
  <data key="d6"></data>
</node>
<node id="Tightly Coupled Workload">
  <data key="d0">Tightly Coupled Workload</data>
  <data key="d1">concept</data>
  <data key="d2">A category of HPC workload where all computers must constantly communicate while solving a problem, used for simulations like airflow, weather prediction, and crash testing.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006105</data>
  <data key="d6"></data>
</node>
<node id="Loosely Coupled Workload">
  <data key="d0">Loosely Coupled Workload</data>
  <data key="d1">concept</data>
  <data key="d2">A category of HPC workload where work divides into independent pieces, used for scenarios like rendering, DNA analysis, and Monte Carlo simulations.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006106</data>
  <data key="d6"></data>
</node>
<node id="GPU-Accelerated Workload">
  <data key="d0">GPU-Accelerated Workload</data>
  <data key="d1">concept</data>
  <data key="d2">A category of HPC workload using graphics processors for massive parallel simple calculations, used for AI training, seismic processing, and medical imaging.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006106</data>
  <data key="d6"></data>
</node>
<node id="Memory-Intensive Workload">
  <data key="d0">Memory-Intensive Workload</data>
  <data key="d1">concept</data>
  <data key="d2">A category of HPC workload requiring massive amounts of active memory, used for genome assembly and city-scale simulations.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006106</data>
  <data key="d6"></data>
</node>
<node id="I/O-Intensive Workload">
  <data key="d0">I/O-Intensive Workload</data>
  <data key="d1">concept</data>
  <data key="d2">A category of HPC workload that spends more time reading and writing data than computing, used for satellite imagery and large-scale data processing.</data>
  <data key="d3">chunk-809d253c9aab5017c77e2a8b92279866</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/get-started-overview.md</data>
  <data key="d5">1777006107</data>
  <data key="d6"></data>
</node>
<node id="High-Performance Computing">
  <data key="d0">High-Performance Computing</data>
  <data key="d1">concept</data>
  <data key="d2">High-performance computing (HPC) refers to computing architectures designed for large-scale, resource-intensive workloads requiring high throughput and low latency.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Job Scheduler">
  <data key="d0">Job Scheduler</data>
  <data key="d1">concept</data>
  <data key="d2">Job Scheduler receives work requests and determines when and where each job should run.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Parallel File System">
  <data key="d0">Parallel File System</data>
  <data key="d1">concept</data>
  <data key="d2">Parallel File System is high-throughput shared storage optimized for concurrent access by many nodes.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Data Sharding">
  <data key="d0">Data Sharding</data>
  <data key="d1">method</data>
  <data key="d2">Distribution of large datasets across multiple storage nodes for parallel access.&lt;SEP&gt;Data Sharding is the distribution of large datasets across multiple storage nodes for parallel access.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481&lt;SEP&gt;chunk-4d2aa553dc8052b724423e935c1fc7fe</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Resource Manager">
  <data key="d0">Resource Manager</data>
  <data key="d1">concept</data>
  <data key="d2">Resource Manager tracks available compute capacity and allocates resources to jobs in the HPC architecture.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Workflow Engine">
  <data key="d0">Workflow Engine</data>
  <data key="d1">concept</data>
  <data key="d2">Workflow Engine coordinates multi-step pipelines and manages dependencies between jobs.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
  <data key="d6"></data>
</node>
<node id="Object Storage">
  <data key="d0">Object Storage</data>
  <data key="d1">concept</data>
  <data key="d2">Object Storage is scalable storage for large datasets, intermediate results, and working data.</data>
  <data key="d3">chunk-1c64e72596f12ff7c458fd34e5a4d481</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/hpc/hpc-architecture-pattern.md</data>
  <data key="d5">1777006138</data>
