  <data key="d1">concept</data>
  <data key="d2">A deployment practice aimed at reducing risk, supported by models like blue/green deployment.</data>
  <data key="d3">chunk-8c68f04b50833c59213a11d31e461972</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/operational-excellence/tradeoffs.md</data>
  <data key="d5">1776981434</data>
  <data key="d6"></data>
</node>
