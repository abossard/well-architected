  <data key="d1">concept</data>
  <data key="d2">Cross-network connectivity refers to connecting Azure resources to external resources in customer private networks, on-premises, or other cloud providers.</data>
  <data key="d3">chunk-e4e1a7707a8a1d8d9f53bc71b18814f3</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/saas/networking.md</data>
  <data key="d5">1777004589</data>
