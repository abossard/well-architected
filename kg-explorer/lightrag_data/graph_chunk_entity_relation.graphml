  <data key="d5">1776999987</data>
  <data key="d6"></data>
</node>
<node id="SOC Team">
  <data key="d0">SOC Team</data>
  <data key="d1">organization</data>
  <data key="d2">The SOC (Security Operations Center) team uses standard format reports for all incidents.</data>
  <data key="d3">chunk-c1d20b573314239b2a88ca3deb8586c1</data>
  <data key="d4">well-architected/security/incident-response.md</data>
  <data key="d5">1776996447</data>
