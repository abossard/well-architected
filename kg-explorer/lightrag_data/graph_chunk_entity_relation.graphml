</node>
<node id="Consumption-Based Billing Model">
  <data key="d0">Consumption-Based Billing Model</data>
  <data key="d1">concept</data>
  <data key="d2">A pricing model where charges are based on actual usage of services, also known as pay-as-you-go.</data>
  <data key="d3">chunk-e259f9d5ef6cf3be37487cfef56d05dc</data>
  <data key="d4">well-architected/cost-optimization/get-best-rates.md</data>
