</node>
<node id="Azure SQL Analytics">
  <data key="d0">Azure SQL Analytics</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure SQL Analytics provides near real-time operational insights for detecting reliability incidents in Azure SQL DB.</data>
  <data key="d3">chunk-65d6d67b4e65531ad950d1206265e623</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-data-platform.md</data>
