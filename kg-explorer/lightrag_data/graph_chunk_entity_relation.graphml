</node>
<node id="Purchasing Ticket">
  <data key="d0">Purchasing Ticket</data>
  <data key="d1">concept</data>
  <data key="d2">Purchasing ticket is a business process directly supported by the authentication and authorization flow, enabling call-center employees to buy tickets on behalf of customers.</data>
  <data key="d3">chunk-e5bf352261b44afadc521c1b327650cc</data>
