  <data key="d5">1776981582</data>
  <data key="d6"></data>
</node>
<node id="Safe Deployment Strategies">
  <data key="d0">Safe Deployment Strategies</data>
  <data key="d1">method</data>
  <data key="d2">Safe deployment strategies require forward and backward compatibility between application logic and data, increasing complexity and testing burden.</data>
  <data key="d3">chunk-3e9454754aa8d04d2fcd10f9b4227d89</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/operational-excellence/tradeoffs.md</data>
  <data key="d5">1776981433</data>
  <data key="d6"></data>
</node>
<node id="Service Discovery">
  <data key="d0">Service Discovery</data>
  <data key="d1">concept</data>
  <data key="d2">Service discovery is a layer of indirection used when workload components independently evolve, which might lack responsiveness and be hard to diagnose.</data>
  <data key="d3">chunk-3e9454754aa8d04d2fcd10f9b4227d89</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/operational-excellence/tradeoffs.md</data>
  <data key="d5">1776981433</data>
  <data key="d6"></data>
</node>
