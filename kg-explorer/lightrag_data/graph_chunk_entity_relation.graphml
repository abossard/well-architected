  <data key="d0">Control Plane Access</data>
  <data key="d1">concept</data>
  <data key="d2">Control plane access involves actions that create, modify, or delete Azure resources.</data>
  <data key="d3">chunk-3ea57e7a575650ba4d31b8ba51cf8991</data>
  <data key="d4">well-architected/security/identity-access.md</data>
