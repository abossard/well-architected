  <data key="d5">1777003467</data>
  <data key="d6"></data>
</node>
<node id="Model Performance Monitoring">
  <data key="d0">Model Performance Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Monitoring deployed model performance to detect problems such as data drift, prediction drift, data quality, and feature attribution drift.</data>
  <data key="d3">chunk-e08b75063568eb6355420ca8b8527f53</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-machine-learning.md</data>
  <data key="d5">1777002243</data>
  <data key="d6"></data>
</node>
<node id="Infrastructure Monitoring">
  <data key="d0">Infrastructure Monitoring</data>
  <data key="d1">method</data>
  <data key="d2">Monitoring online endpoints and training infrastructure to track metrics like request latency, memory, CPU/GPU usage.</data>
  <data key="d3">chunk-e08b75063568eb6355420ca8b8527f53</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/service-guides/azure-machine-learning.md</data>
  <data key="d5">1777002243</data>
  <data key="d6"></data>
</node>
<node id="Machine Learning Workspace">
  <data key="d0">Machine Learning Workspace</data>
  <data key="d1">concept</data>
  <data key="d2">A Machine Learning workspace is a central resource for machine learning activities, requiring security controls for availability, confidentiality, and integrity.</data>
  <data key="d3">chunk-e7c50c3fc68e8ca3e2a2600f5ec515c5</data>
