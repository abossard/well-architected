<node id="Business Criticality In Cloud Management">
  <data key="d0">Business Criticality In Cloud Management</data>
  <data key="d1">content</data>
  <data key="d2">A resource within Azure Cloud Adoption Framework covering business criticality classification.</data>
  <data key="d3">chunk-839c6849bb3baf2d3e29441a3b61a033</data>
