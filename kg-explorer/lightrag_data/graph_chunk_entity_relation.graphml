  <data key="d6"></data>
</node>
<node id="Microsoft Zero Trust Model">
  <data key="d0">Microsoft Zero Trust Model</data>
  <data key="d1">method</data>
  <data key="d2">The Microsoft Zero Trust model is a security framework used as a compass to mitigate security risks in workload design.&lt;SEP&gt;The Microsoft Zero Trust model is a security framework used as a compass to mitigate security risks in workload design.</data>
