<node id="BCDR Drills">
  <data key="d0">BCDR Drills</data>
  <data key="d1">method</data>
  <data key="d2">Business continuity and disaster recovery (BCDR) drills validate documented processes using scenarios including security compromise.</data>
  <data key="d3">chunk-c1d20b573314239b2a88ca3deb8586c1</data>
  <data key="d4">well-architected/security/incident-response.md</data>
