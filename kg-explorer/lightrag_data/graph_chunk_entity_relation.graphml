  <data key="d6"></data>
</node>
<node id="Surface Area">
  <data key="d0">Surface Area</data>
  <data key="d1">concept</data>
  <data key="d2">A logical footprint of a workload that contains vulnerabilities.</data>
  <data key="d3">chunk-6f8c5639aa16c2329aa96771580d1b65</data>
  <data key="d4">well-architected/security/harden-resources.md</data>
  <data key="d5">1776996333</data>
  <data key="d6"></data>
</node>
<node id="Deny-By-Default">
  <data key="d0">Deny-By-Default</data>
  <data key="d1">method</data>
  <data key="d2">Deny-by-default is a network segmentation approach where access is only added to the allowlist if justified.</data>
  <data key="d3">chunk-6f8c5639aa16c2329aa96771580d1b65</data>
  <data key="d4">well-architected/security/harden-resources.md</data>
  <data key="d5">1776996334</data>
