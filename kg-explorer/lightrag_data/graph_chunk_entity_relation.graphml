  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
  <data key="d5">1777005824</data>
  <data key="d6"></data>
</node>
<node id="Result Caching">
  <data key="d0">Result Caching</data>
  <data key="d1">method</data>
  <data key="d2">Result caching stores outputs of previous computations or predictions to quickly retrieve cached results instead of recalculating them.</data>
  <data key="d3">chunk-c5dafaf64829c3146ac17935b49a986e</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/sustainability/sustainable-ai-design.md</data>
