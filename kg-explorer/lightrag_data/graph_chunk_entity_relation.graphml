  <data key="d6"></data>
</node>
<node id="Azure Activity Log">
  <data key="d0">Azure Activity Log</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Activity Log is used to audit parameter changes on server instances.</data>
  <data key="d3">chunk-7b3fcfb30f28cfcb4e8d95e057040687</data>
