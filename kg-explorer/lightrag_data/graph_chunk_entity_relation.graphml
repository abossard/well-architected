  <data key="d6"></data>
</node>
<node id="Mission-Critical Connected">
  <data key="d0">Mission-Critical Connected</data>
  <data key="d1">content</data>
  <data key="d2">Mission-Critical Connected is a reference implementation available at GitHub providing a comprehensive health model example.</data>
  <data key="d3">chunk-aee778ccfa3886c52f485cafeef0009b</data>
  <data key="d4">/Users/abossard/Desktop/cxe/well-architected/well-architected/mission-critical/mission-critical-health-modeling.md</data>
