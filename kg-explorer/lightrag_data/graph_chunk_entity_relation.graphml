  <data key="d5">1777003079</data>
  <data key="d6"></data>
</node>
<node id="Periodic Backup Mode">
  <data key="d0">Periodic Backup Mode</data>
  <data key="d1">method</data>
  <data key="d2">The default backup mode for Azure Cosmos DB with configurable intervals and retention periods, requiring a support request for restore operations.</data>
  <data key="d3">chunk-caad63f908cd3b639ca5d51c5a2341ae</data>
