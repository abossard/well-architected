</node>
<node id="Net Zero">
  <data key="d0">Net Zero</data>
  <data key="d1">concept</data>
  <data key="d2">Net Zero is a target reached when carbon emissions are eliminated where possible and residual emissions are compensated.&lt;SEP&gt;A target reached when carbon emissions are eliminated where possible and residual emissions are compensated.</data>
  <data key="d3">chunk-467c7e51d8f6452fcd14acfb1b838b59&lt;SEP&gt;chunk-5b69de4dd949df6b1d5f8a06ccc255f3</data>
