<node id="Azure Resource Manager Templates">
  <data key="d0">Azure Resource Manager Templates</data>
  <data key="d1">artifact</data>
  <data key="d2">ARM templates are Azure-native IaC artifacts for infrastructure deployment.</data>
  <data key="d3">chunk-06f6956528b19bfc513c2a4b70a66e71</data>
  <data key="d4">well-architected/mission-critical/mission-critical-deployment-testing.md</data>
