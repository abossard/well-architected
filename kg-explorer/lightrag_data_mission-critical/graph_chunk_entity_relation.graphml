  <data key="d0">Microsoft Global Backbone Network</data>
  <data key="d1">artifact</data>
  <data key="d2">The Microsoft global backbone network is used by Azure Front Door to forward requests efficiently to backend endpoints.</data>
  <data key="d3">chunk-1ff5c56a565c7a13e4cc5066c5ed0775</data>
