</node>
<node id="Secret Management">
  <data key="d0">Secret Management</data>
  <data key="d1">concept</data>
  <data key="d2">Secret management involves handling key, secret, and certificate rotation to prevent application outages and maintain security and availability.</data>
  <data key="d3">chunk-6bb2c831e41151a23a478ec8c59ab787</data>
  <data key="d4">well-architected/mission-critical/mission-critical-operational-procedures.md</data>
