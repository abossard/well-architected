<node id="Query Performance Insights">
  <data key="d0">Query Performance Insights</data>
  <data key="d1">artifact</data>
  <data key="d2">Query Performance Insights optimizes queries, tables, and databases in Azure SQL Database.&lt;SEP&gt;Query Performance Insights is a tool for Azure SQL Database that helps identify and analyze query performance issues.</data>
  <data key="d3">chunk-73f080a578e1d5bcb7bab91a722b1c8c&lt;SEP&gt;chunk-65d6d67b4e65531ad950d1206265e623</data>
