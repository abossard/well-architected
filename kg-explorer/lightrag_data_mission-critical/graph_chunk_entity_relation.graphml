</node>
<node id="Soft Delete">
  <data key="d0">Soft Delete</data>
  <data key="d1">method</data>
  <data key="d2">Soft Delete is a pattern where data records are flagged as deleted rather than explicitly removed, enabling inclusion in the change feed.&lt;SEP&gt;Soft Delete is a change feed design pattern in Azure Cosmos DB for handling deleted data.</data>
  <data key="d3">chunk-0709e0d30d586072a6b10881d6bc306c&lt;SEP&gt;chunk-4b4894fcd598b00b3316bd49945a116d</data>
