  <data key="d0">Unified Data Sink</data>
  <data key="d1">concept</data>
  <data key="d2">A unified data sink consolidates all operational data for correlated analysis to build a single pane representation of application health.</data>
  <data key="d3">chunk-aee778ccfa3886c52f485cafeef0009b</data>
  <data key="d4">well-architected/mission-critical/mission-critical-health-modeling.md</data>
  <data key="d5">1777291770</data>
  <data key="d6"></data>
</node>
<node id="Azure Dashboards">
  <data key="d0">Azure Dashboards</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Dashboards is a visualization solution providing integrated out-of-the-box representation of operational data within Azure Monitor.&lt;SEP&gt;Azure Dashboards is a visualization tool for representing health models and business requirements.</data>
  <data key="d3">chunk-09511819f8c1ba5a16e71983efd9f8b7&lt;SEP&gt;chunk-a26205fb34c4e32a46218f4e0a88ca82</data>
