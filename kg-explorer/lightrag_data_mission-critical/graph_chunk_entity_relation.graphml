<node id="Caching For Hot Tier Data">
  <data key="d0">Caching For Hot Tier Data</data>
  <data key="d1">concept</data>
  <data key="d2">An in-memory caching layer concept that enhances data platforms by increasing read throughput and improving response times for hot tier data scenarios.</data>
  <data key="d3">chunk-058624a53f7dcacddad189523984d8b2</data>
  <data key="d4">well-architected/mission-critical/mission-critical-data-platform.md</data>
