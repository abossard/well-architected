  <data key="d6"></data>
</node>
<node id="Update Management">
  <data key="d0">Update Management</data>
  <data key="d1">concept</data>
  <data key="d2">Update management involves monitoring, detecting, testing, and applying updates to application resources, runtime dependencies, and platform components regularly.</data>
  <data key="d3">chunk-6bb2c831e41151a23a478ec8c59ab787</data>
  <data key="d4">well-architected/mission-critical/mission-critical-operational-procedures.md</data>
  <data key="d5">1777292096</data>
  <data key="d6"></data>
</node>
<node id="Azure Key Vault">
  <data key="d0">Azure Key Vault</data>
  <data key="d1">artifact</data>
  <data key="d2">Azure Key Vault is a secret management solution that supports expiry settings, key rotation, and alerting for upcoming expirations.&lt;SEP&gt;Azure Key Vault is an Azure service for managing secrets, keys, and certificates.&lt;SEP&gt;Azure Key Vault is a secure repository for secrets, certificates, and keys, providing high availability, redundancy, and a security boundary with transaction limits and throttling.&lt;SEP&gt;Azure Key Vault is an Azure service for managing secrets, keys, and certificates, supporting FIPS 140 validation and managed HSM.&lt;SEP&gt;Azure Key Vault is a secure storage service for secrets and keys.</data>
  <data key="d3">chunk-98dfe7557b9ff125211f2a2e03cb3dce&lt;SEP&gt;chunk-682b99a48c23e193c28d8a4eae469e68&lt;SEP&gt;chunk-14c9347a4bec9630cfbf008260182d80&lt;SEP&gt;chunk-a8deba810ca14d9b278b1f9d887802f2&lt;SEP&gt;chunk-65bdd00b5709152c19e73a1ad56171cd</data>
