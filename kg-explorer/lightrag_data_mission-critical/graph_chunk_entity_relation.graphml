  <data key="d0">Threat Modeling</data>
  <data key="d1">method</data>
  <data key="d2">Threat modeling provides a risk-based approach to security design using identified potential threats to develop appropriate security mitigations.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf</data>
  <data key="d4">well-architected/mission-critical/mission-critical-security.md</data>
