  <data key="d0">SIEM</data>
  <data key="d1">artifact</data>
  <data key="d2">Security Information and Event Management tooling used for tracking security and audit events and incident response.</data>
  <data key="d3">chunk-75881c2e5d7a1909b7080e2819bc0413</data>
