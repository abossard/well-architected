  <data key="d0">Defense-In-Depth</data>
  <data key="d1">concept</data>
  <data key="d2">Defense-in-depth is a layered approach to define and implement compensating mitigations for modeled threats.</data>
  <data key="d3">chunk-bc6c19c90a7ec75e7d95d807c1817fcf</data>
  <data key="d4">well-architected/mission-critical/mission-critical-security.md</data>
  <data key="d5">1777292361</data>
  <data key="d6"></data>
</node>
