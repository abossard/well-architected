<node id="DocumentDB Account Contributor">
  <data key="d0">DocumentDB Account Contributor</data>
  <data key="d1">concept</data>
  <data key="d2">A built-in RBAC role enabling management of Azure Cosmos DB accounts including keys and role assignments, but not data-plane access.&lt;SEP&gt;DocumentDB Account Contributor is a built-in RBAC role for contributing to Azure Cosmos DB accounts.</data>
  <data key="d3">chunk-0709e0d30d586072a6b10881d6bc306c&lt;SEP&gt;chunk-4b4894fcd598b00b3316bd49945a116d</data>
