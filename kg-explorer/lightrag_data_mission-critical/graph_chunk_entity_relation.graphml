  <data key="d6"></data>
</node>
<node id="GitHub Dependabot">
  <data key="d0">GitHub Dependabot</data>
  <data key="d1">artifact</data>
  <data key="d2">GitHub Dependabot is a tool used to monitor and automatically detect updates for dependencies.&lt;SEP&gt;GitHub Dependabot is a tool for automated dependency management.</data>
  <data key="d3">chunk-6bb2c831e41151a23a478ec8c59ab787&lt;SEP&gt;chunk-682b99a48c23e193c28d8a4eae469e68</data>
