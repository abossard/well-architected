  <data key="d6"></data>
</node>
<node id="Mission-Critical Design">
  <data key="d0">Mission-Critical Design</data>
  <data key="d1">concept</data>
  <data key="d2">Mission-critical design endorses ephemeral stateless application resources and maximum-reliability requirements.</data>
  <data key="d3">chunk-6bb2c831e41151a23a478ec8c59ab787</data>
  <data key="d4">well-architected/mission-critical/mission-critical-operational-procedures.md</data>
